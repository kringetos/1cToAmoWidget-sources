Процедура ЗаписатьЛогAPI(Эндпоинт, Метод, КодОтвета, ТелоЗапроса = "", ТелоОтвета = "", ТекстОшибки = "", AmoID = "") Экспорт
	
	МенеджерЗаписи = РегистрыСведений.TeMa_ЛогиAPI.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЛога = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.ДатаВремя         = ТекущаяДата();
	МенеджерЗаписи.Эндпоинт          = Эндпоинт;
	МенеджерЗаписи.Метод             = Метод;
	МенеджерЗаписи.КодОтвета         = КодОтвета;
	МенеджерЗаписи.AmoID             = AmoID;
	МенеджерЗаписи.ТелоЗапроса       = ТелоЗапроса;
	МенеджерЗаписи.ТелоОтвета        = ТелоОтвета;
	МенеджерЗаписи.ТекстОшибки       = ТекстОшибки;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ЛогированиеAPI.ОшибкаЗаписи", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Функция ОшибкаJSON(Ответ, Код, Текст, ТелоЗапроса = "", Эндпоинт = "Неизвестно")
	Ответ.КодСостояния = Код; 
	УстановитьЗаголовкиCORS(Ответ);
	
	СтрокаОшибки = "{""error"": """ + СтрЗаменить(Текст, """", "\""") + """}";
	Ответ.Тело = СтрокаОшибки;
	
	// Пишем в лог
	ЗаписатьЛогAPI(Эндпоинт, "POST/GET", Код, ТелоЗапроса, СтрокаОшибки, Текст);
	
	Возврат Ответ;КонецФункции

Функция УспехJSON(Ответ, СтруктураДанных)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	УстановитьЗаголовкиCORS(Ответ); // <-- Добавили CORS
	Ответ.Тело = ЗаписьJSON.Закрыть();
	Возврат Ответ;
КонецФункции

Процедура УстановитьЗаголовкиCORS(Ответ)
	// Для продакшена с авторизацией тут нужно будет заменить "*" на домен AmoCRM
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, Accept, X-Requested-With");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
КонецПроцедуры

Функция ГенерацияСчетаСоздатьСчет(Запрос)
	Ответ = Новый Структура("КодСостояния,Заголовки,Тело", 200, Новый Соответствие, "");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос;
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Пустое тело запроса");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") И ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Ожидается JSON-объект");
	КонецЕсли;
	
	// 1. Получаем GUID нашего заказа из JSON
	ЗначениеID = Данные.Получить("order_id");
	Если ЗначениеID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	СтрокаGUID = СокрЛП(Строка(ЗначениеID));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Поле order_id не может быть пустым");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (укажите правильное имя поля из вашего JSON, например "amo_id")
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Документ.TeMa_ЗаказПокупателя КАК TeMa_ЗаказПокупателя
		|ГДЕ
		|	TeMa_ЗаказПокупателя.Ссылка = &Ссылка";
	ЗапросБД.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
	
	Если ЗапросБД.Выполнить().Пустой() Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;   
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_Счет КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем Счет на оплату
	НовыйСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	
	Попытка
		// Программный ввод на основании
		НовыйСчет.Заполнить(СсылкаНаЗаказ);
		НовыйСчет.Дата = ТекущаяДата();
		
		Если НЕ ЗначениеЗаполнено(НовыйСчет.Организация) Тогда
			НовыйСчет.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		// --- РУЧНАЯ ГЕНЕРАЦИЯ КАСТОМНОГО НОМЕРА (АМО-...) ---
		ПрефиксАМО = "АМО-";
		
		ДлинаНомера = Метаданные.Документы.СчетНаОплатуПокупателю.ДлинаНомера; 
		Если ДлинаНомера <= 0 Тогда 
			ДлинаНомера = 11;
		КонецЕсли;
		
		ЗапросНомер = Новый Запрос;
		ЗапросНомер.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Счет.Номер КАК Номер
			|ИЗ
			|	Документ.СчетНаОплатуПокупателю КАК Счет
			|ГДЕ
			|	Счет.Номер ПОДОБНО &Префикс
			|УПОРЯДОЧИТЬ ПО
			|	Номер УБЫВ";
		ЗапросНомер.УстановитьПараметр("Префикс", ПрефиксАМО + "%");
		
		Выборка = ЗапросНомер.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЧисловаяЧасть = Сред(Выборка.Номер, СтрДлина(ПрефиксАМО) + 1);
			Попытка
				СледующийНомер = Число(ЧисловаяЧасть) + 1;
			Исключение
				СледующийНомер = 1;
			КонецПопытки;
		Иначе
			СледующийНомер = 1;
		КонецЕсли;
		
		ДлинаЧисла = ДлинаНомера - СтрДлина(ПрефиксАМО);
		ФорматСтрока = "ЧЦ=" + ДлинаЧисла + "; ЧВН=; ЧГ=0";
		
		НовыйСчет.Номер = ПрефиксАМО + СтрЗаменить(Формат(СледующийНомер, ФорматСтрока), " ", "");
		// ----------------------------------------------------
		
		// Попытка проведения
		НовыйСчет.Записать(РежимЗаписиДокумента.Проведение);
		
		СтатусДокумента = "created";
		ОписаниеОшибкиПроведения = "";
		
	Исключение
		ОписаниеОшибкиПроведения = ОписаниеОшибки();
		СтатусДокумента = "draft";
		
		// Если не провелся — пишем как черновик
		Попытка
			НовыйСчет.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Критическая ошибка при записи черновика Счета: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;
	
	// ---> НОВОЕ: 3.1. Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_Счет"   
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Счет.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение    
		МенеджерЗаписи.Версия = НомерВерсии;
		МенеджерЗаписи.Счет = НовыйСчет.Ссылка;             // Ресурс (ссылка на сохраненный документ)
		МенеджерЗаписи.Записать();
	Исключение
		// Если по какой-то причине в регистр не записалось (например, дубль), вернем ошибку 500
		Возврат ОшибкаJSON(Ответ, 500, "Счет создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM: " + ОписаниеОшибки());
	КонецПопытки;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 4. Формируем ответ
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("status", СтатусДокумента);
	СтруктураОтвета.Вставить("invoice_id", Строка(НовыйСчет.Ссылка.УникальныйИдентификатор()));
	СтруктураОтвета.Вставить("invoice_number", НовыйСчет.Номер);
	
	Если СтатусДокумента = "draft" Тогда
		СтруктураОтвета.Вставить("error_reason", ОписаниеОшибкиПроведения);
		Ответ.КодСостояния = 202; // 202 Accepted
	КонецЕсли;
	
	Возврат УспехJSON(Ответ, СтруктураОтвета);
КонецФункции

Функция ГенерацияУПДСоздатьУПД(Запрос) 
Ответ = Новый Структура("КодСостояния,Заголовки,Тело", 200, Новый Соответствие, "");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос;
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Пустое тело запроса");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") И ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Ожидается JSON-объект");
	КонецЕсли;
	
	// 1. Получаем GUID нашего заказа из JSON
	ЗначениеID = Данные.Получить("order_id");
	Если ЗначениеID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	СтрокаGUID = СокрЛП(Строка(ЗначениеID));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Поле order_id не может быть пустым");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (укажите правильное имя поля из вашего JSON, например "amo_id")
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Документ.TeMa_ЗаказПокупателя КАК TeMa_ЗаказПокупателя
		|ГДЕ
		|	TeMa_ЗаказПокупателя.Ссылка = &Ссылка";
	ЗапросБД.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
	
	Если ЗапросБД.Выполнить().Пустой() Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_УПД КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем документ Реализация товаров и услуг
	НоваяРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	
	Попытка
		НоваяРеализация.Дата = ТекущаяДата();
		
		// --- 1. ПЕРЕНОСИМ КОНТРАГЕНТА И ПРОВЕРЯЕМ ЕГО ---
		НоваяРеализация.Контрагент = СсылкаНаЗаказ.Контрагент;
		
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Контрагент) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: В документе TeMa_ЗаказПокупателя не заполнен Контрагент!");
		КонецЕсли;
		
		// Договор из явного выбора, ссылки заказа или прежней связи amoCRM.
		Попытка
			СсылкаНаДоговор = TeMa_СобытияСервера.TeMa_ДоговорЗаказа(СсылкаНаЗаказ, Данные.Получить("contract_id"));
		Исключение
			Возврат ОшибкаJSON(Ответ, 400, ОписаниеОшибки());
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(СсылкаНаДоговор) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: У контрагента нет ни одного договора с видом 'С покупателем'.");
		КонецЕсли;
		
		НоваяРеализация.ДоговорКонтрагента = СсылкаНаДоговор;
		
		// --- 3. ЗАПОЛНЯЕМ ОСТАЛЬНЫЕ РЕКВИЗИТЫ ---
		НоваяРеализация.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
		НоваяРеализация.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("643"); // Рубли
		
		// ОБЯЗАТЕЛЬНЫЕ ФЛАГИ ДЛЯ КОРРЕКТНОЙ РАБОТЫ ФОРМЫ 1С
		НоваяРеализация.СуммаВключаетНДС = Истина;
		
		// Страховка Организации
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.БанковскийСчетОрганизации) Тогда
			НоваяРеализация.Организация = СсылкаНаЗаказ.БанковскийСчетОрганизации.Владелец;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Организация) Тогда
			НоваяРеализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Организация) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: Не удалось определить Организацию для Реализации.");
		КонецЕсли;		
		
		// Страховка Склада
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.Склад) Тогда
			НоваяРеализация.Склад = СсылкаНаЗаказ.Склад;
		Иначе
			НоваяРеализация.Склад = Справочники.Склады.НайтиПоНаименованию("Основной склад");
		КонецЕсли;
		
		// Заполняем Счета расчетов с контрагентом
		НоваяРеализация.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");
		НоваяРеализация.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02");
		
		// 4. ПЕРЕНОСИМ ТОВАРЫ
		Для Каждого СтрокаЗаказа Из СсылкаНаЗаказ.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			НовСтрока = НоваяРеализация.Товары.Добавить();
			НовСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
		// Номенклатурная группа для аналитики доходов и расходов.
		Попытка
			ГруппаНоменклатуры = НовСтрока.Номенклатура.НоменклатурнаяГруппа;
			НовСтрока.Субконто = ГруппаНоменклатуры;
		Исключение
			Возврат ОшибкаJSON(Ответ, 400,
				"Не удалось заполнить номенклатурную группу для товара "
				+ Строка(НовСтрока.Номенклатура) + ": " + ОписаниеОшибки());
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
			Возврат ОшибкаJSON(Ответ, 400,
				"В карточке товара не заполнена номенклатурная группа: "
				+ Строка(НовСтрока.Номенклатура));
		КонецЕсли;
			НовСтрока.Количество   = СтрокаЗаказа.Количество;
			НовСтрока.Цена         = СтрокаЗаказа.Цена;
			НовСтрока.Сумма        = TeMa_СобытияСервера.TeMa_СуммаСтрокиСНДС(СтрокаЗаказа);
			НовСтрока.СуммаНДС     = СтрокаЗаказа.СуммаНДС;
			
			Если ЗначениеЗаполнено(СтрокаЗаказа.НДС) Тогда
				НовСтрока.СтавкаНДС = СтрокаЗаказа.НДС;
			Иначе
				НовСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; 
			КонецЕсли;
			
			НовСтрока.СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
			НовСтрока.СчетДоходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1");
			НовСтрока.СчетРасходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1");
			НовСтрока.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03");
		КонецЦикла;
		
		Если НоваяРеализация.Товары.Количество() = 0 Тогда
			Возврат ОшибкаJSON(Ответ, 400, "В заказе TeMa_ЗаказПокупателя нет товаров для переноса!");
		КонецЕсли;
		
		// --- 5. ГЕНЕРАЦИЯ НОМЕРА (АМО-...) ---
		ПрефиксАМО = "АМО-";
		ДлинаНомера = Метаданные.Документы.РеализацияТоваровУслуг.ДлинаНомера; 
		Если ДлинаНомера <= 0 Тогда 
			ДлинаНомера = 11;
		КонецЕсли;
		
		ЗапросНомер = Новый Запрос;
		ЗапросНомер.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Реализация.Номер КАК Номер
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|ГДЕ
			|	Реализация.Номер ПОДОБНО &Префикс
			|УПОРЯДОЧИТЬ ПО
			|	Номер УБЫВ";
		ЗапросНомер.УстановитьПараметр("Префикс", ПрефиксАМО + "%");
		
		Выборка = ЗапросНомер.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЧисловаяЧасть = Сред(Выборка.Номер, СтрДлина(ПрефиксАМО) + 1);
			Попытка
				СледующийНомер = Число(ЧисловаяЧасть) + 1;
			Исключение
				СледующийНомер = 1;
			КонецПопытки;
		Иначе
			СледующийНомер = 1;
		КонецЕсли;
		
		ДлинаЧисла = ДлинаНомера - СтрДлина(ПрефиксАМО);
		ФорматСтрока = "ЧЦ=" + ДлинаЧисла + "; ЧВН=; ЧГ=0";
		НоваяРеализация.Номер = ПрефиксАМО + СтрЗаменить(Формат(СледующийНомер, ФорматСтрока), " ", "");
				
		// 6. ПОПЫТКА ПРОВЕДЕНИЯ
		НоваяРеализация.Записать(РежимЗаписиДокумента.Проведение);
		
		СтатусДокумента = "posted";
		ОписаниеОшибкиПроведения = "";
	Исключение
		ПолныйТекстОшибки = ОписаниеОшибки();
		
		ПозицияОшибки = Найти(ПолныйТекстОшибки, "}:");
		Если ПозицияОшибки > 0 Тогда
			ОписаниеОшибкиПроведения = СокрЛП(Сред(ПолныйТекстОшибки, ПозицияОшибки + 2));
		Иначе
			ОписаниеОшибкиПроведения = ПолныйТекстОшибки;
		КонецЕсли;
		
		СтатусДокумента = "draft";
		
		Попытка
			НоваяРеализация.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Критическая ошибка при записи черновика Реализации: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;
	
	// ---> НОВОЕ: 6.1. Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_УПД"
	Попытка
		МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_УПД.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение     
		МенеджерЗаписи.Версия = НомерВерсии; // Измерение
		МенеджерЗаписи.УПД = НоваяРеализация.Ссылка;        // Ресурс (обрати внимание, здесь реквизит называется УПД)
		МенеджерЗаписи.Записать();
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "УПД создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM_УПД: " + ОписаниеОшибки());
	КонецПопытки;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 4. Формируем ответ
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("status", СтатусДокумента);
	СтруктураОтвета.Вставить("delivery_id", Строка(НоваяРеализация.Ссылка.УникальныйИдентификатор()));
	СтруктураОтвета.Вставить("delivery_number", НоваяРеализация.Номер);
	
	Если СтатусДокумента = "draft" Тогда
		СтруктураОтвета.Вставить("error_reason", ОписаниеОшибкиПроведения);
		Ответ.КодСостояния = 202; 
	КонецЕсли;
	
	Возврат УспехJSON(Ответ, СтруктураОтвета);
КонецФункции

Функция ГенерацияДКПСоздатьДКП(Запрос)
Ответ = Новый Структура("КодСостояния,Заголовки,Тело", 200, Новый Соответствие, "");
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	// 1. Получаем GUID нашего заказа из JSON
	СтрокаGUID = СокрЛП(Строка(Данные.Получить("order_id")));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (нужен для записи в регистр)
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	Если СсылкаНаЗаказ.ПолучитьОбъект() = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаЗаказ.Контрагент) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "В заказе не заполнен Контрагент. Невозможно создать договор.");
	КонецЕсли;
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_ЗаказПокупателя КАК Рег
			|ГДЕ
			|	Рег.amo_id = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем новый элемент справочника "Договоры контрагентов"
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		
		НовыйДоговор.Владелец = СсылкаНаЗаказ.Контрагент;
		НовыйДоговор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.БанковскийСчетОрганизации) Тогда
			НовыйДоговор.Организация = СсылкаНаЗаказ.БанковскийСчетОрганизации.Владелец;
		Иначе
			НовыйДоговор.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");
		
		// --- НАИМЕНОВАНИЕ ДОГОВОРА ---
		СтрокаНаименование = Строка(Данные.Получить("contract_name"));
		Если ЗначениеЗаполнено(СтрокаНаименование) И СтрокаНаименование <> "Неопределено" Тогда
			НовыйДоговор.Наименование = СокрЛП(СтрокаНаименование);
		Иначе
			НовыйДоговор.Наименование = "Договор купли продажи AmoCRM";
		КонецЕсли;
		
		// --- НОМЕР И ДАТА ДОГОВОРА ---
		СтрокаНомерДоговора = Строка(Данные.Получить("contract_number"));
		Если ЗначениеЗаполнено(СтрокаНомерДоговора) И СтрокаНомерДоговора <> "Неопределено" Тогда
			НовыйДоговор.Номер = СокрЛП(СтрокаНомерДоговора);
		Иначе
			НовыйДоговор.Номер = Строка(СсылкаНаЗаказ.Номер); 
		КонецЕсли;
		
		ЗначениеДатаДоговора = Данные.Получить("contract_date");
		Если ЗначениеДатаДоговора <> Неопределено Тогда
			Попытка
				НовыйДоговор.Дата = XMLЗначение(Тип("Дата"), Строка(ЗначениеДатаДоговора));
			Исключение
				НовыйДоговор.Дата = ТекущаяДата();
			КонецПопытки;
		Иначе
			НовыйДоговор.Дата = ТекущаяДата();
		КонецЕсли;
		
		НовыйДоговор.СуммаВключаетНДС = Истина;
		
		Если СсылкаНаЗаказ.Товары.Количество() > 0 Тогда
			НовыйДоговор.СтавкаНДС = СсылкаНаЗаказ.Товары[0].НДС;
		КонецЕсли;

		Попытка
			НовыйДоговор.СпособВыставленияДокументов = Перечисления.СпособыВыставленияДокументов.Автоматически;
		Исключение
		КонецПопытки;

		Попытка
			НовыйДоговор.Руководитель = Справочники.ФизическиеЛица.НайтиПоНаименованию("Иванов Павел Викторович"); 
			СсылкаНаДолжность = Справочники.Должности.НайтиПоНаименованию("Директор");
			Если ЗначениеЗаполнено(СсылкаНаДолжность) Тогда
				НовыйДоговор.ДолжностьРуководителя = СсылкаНаДолжность;
			КонецЕсли;
		Исключение
		КонецПопытки;

		СтрокаФИО = Строка(Данные.Получить("counterparty_director"));
		Если ЗначениеЗаполнено(СтрокаФИО) И СтрокаФИО <> "Неопределено" Тогда
			НовыйДоговор.РуководительКонтрагента = СокрЛП(СтрокаФИО);
		Иначе
			НовыйДоговор.РуководительКонтрагента = СсылкаНаЗаказ.Контрагент.Наименование;
		КонецЕсли;

		СтрокаДолжность = Строка(Данные.Получить("counterparty_position"));
		Если ЗначениеЗаполнено(СтрокаДолжность) И СтрокаДолжность <> "Неопределено" Тогда
			НовыйДоговор.ДолжностьРуководителяКонтрагента = СокрЛП(СтрокаДолжность);
		Иначе
			НовыйДоговор.ДолжностьРуководителяКонтрагента = "Генеральный директор"; 
		КонецЕсли;
		
		СтрокаОснование = Строка(Данные.Получить("counterparty_acting_on_basis"));
		Если ЗначениеЗаполнено(СтрокаОснование) И СтрокаОснование <> "Неопределено" Тогда
			НовыйДоговор.ад_Устав = СокрЛП(СтрокаОснование); 
		КонецЕсли;

		Попытка
			ЗначениеСуммаПредоплаты = Данные.Получить("prepayment_amount");
			Если ЗначениеСуммаПредоплаты <> Неопределено Тогда
				НовыйДоговор.ад_СуммаПредоплаты = Число(ЗначениеСуммаПредоплаты);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаПредоплаты", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеСрокОтгрузки = Данные.Получить("delivery_term");
			Если ЗначениеСрокОтгрузки <> Неопределено Тогда
				НовыйДоговор.ад_СрокОтгрузки = Число(ЗначениеСрокОтгрузки); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаСрокаОтгрузки", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеСрокГарантии = Данные.Получить("warranty_term");
			Если ЗначениеСрокГарантии <> Неопределено Тогда
				НовыйДоговор.ад_СрокГарантии = Число(ЗначениеСрокГарантии); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаСрокаГарантии", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеОбъемСУГ = Данные.Получить("sug_volume");
			Если ЗначениеОбъемСУГ <> Неопределено Тогда
				НовыйДоговор.ад_ОбъемСУГ = Число(ЗначениеОбъемСУГ); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаОбъемаСУГ", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			НовыйДоговор.Сумма = СсылкаНаЗаказ.СуммаДокумента;
		Исключение
		КонецПопытки;

		Для Каждого СтрокаЗаказа Из СсылкаНаЗаказ.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			НовСтрока = НовыйДоговор.ад_Спецификация.Добавить(); 
			НовСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
			НовСтрока.Количество   = СтрокаЗаказа.Количество;
			НовСтрока.Цена         = СтрокаЗаказа.Цена;
			НовСтрока.Сумма        = TeMa_СобытияСервера.TeMa_СуммаСтрокиСНДС(СтрокаЗаказа);
			НовСтрока.СуммаНДС     = СтрокаЗаказа.СуммаНДС;
			
			Попытка
				НовСтрока.Всего = СтрокаЗаказа.Всего; 
			Исключение
			КонецПопытки;
			
			Если ЗначениеЗаполнено(СтрокаЗаказа.НДС) Тогда
				НовСтрока.СтавкаНДС = СтрокаЗаказа.НДС;
			Иначе
				НовСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; 
			КонецЕсли;
		КонецЦикла;
		
		НовыйДоговор.Записать();
		
		// 4. ПРИВЯЗЫВАЕМ ДОГОВОР К ЗАКАЗУ
		ОбъектЗаказа = СсылкаНаЗаказ.ПолучитьОбъект();
		ОбъектЗаказа.Договор = НовыйДоговор.Ссылка;
		ОбъектЗаказа.Записать(РежимЗаписиДокумента.Запись); 
		
		// ---> НОВОЕ: Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_Договор"
		Попытка
			МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Договор.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение     
			МенеджерЗаписи.Версия = НомерВерсии; // Измерение
			МенеджерЗаписи.Договор = НовыйДоговор.Ссылка;       // Ресурс (ссылка на сохраненный договор)
			МенеджерЗаписи.Записать();
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Договор создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM_Договор: " + ОписаниеОшибки());
		КонецПопытки;
		// <--- КОНЕЦ НОВОГО БЛОКА
		
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("status", "created");
		СтруктураОтвета.Вставить("contract_id", Строка(НовыйДоговор.Ссылка.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("contract_name", НовыйДоговор.Наименование);
		
		Возврат УспехJSON(Ответ, СтруктураОтвета);
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при создании Договора: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции
Процедура AssertPrice(Условие, Сообщение)
    Если НЕ Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Функция JSONPrice(Данные)
    З = Новый ЗаписьJSON; З.УстановитьСтроку(); ЗаписатьJSON(З, Данные); Возврат З.Закрыть();
КонецФункции

Функция ReadPrice(Ответ)
    Если Ответ.КодСостояния >= 400 Тогда ВызватьИсключение Ответ.Тело; КонецЕсли;
    Ч = Новый ЧтениеJSON; Ч.УстановитьСтроку(Ответ.Тело); Р = ПрочитатьJSON(Ч, Истина); Ч.Закрыть(); Возврат Р;
КонецФункции

Функция PriceContractCase(Имя, Ставка, Количество, Цена, НДС)
    Р = Новый Структура("name,passed", Имя, Ложь);
    НачатьТранзакцию();
    Попытка
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Заказ, Т.НомерСтроки КАК НомерСтроки ИЗ Документ.TeMa_ЗаказПокупателя.Товары КАК Т ГДЕ Т.Номенклатура.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка) И Т.Количество > 0 УПОРЯДОЧИТЬ ПО Т.Ссылка.Дата УБЫВ");
        В = З.Выполнить().Выбрать(); AssertPrice(В.Следующий(), "No source order");
        Исх = В.Заказ.ПолучитьОбъект(); С = Исх.Товары[В.НомерСтроки - 1];
        О = Исх.Скопировать(); О.Дата = ТекущаяДата(); О.IDСделкиAmo = "9900261027";
        О.Договор = "legacy"; О.Товары.Очистить(); Т = О.Товары.Добавить(); ЗаполнитьЗначенияСвойств(Т, С);
        Итог = Окр(Количество * Цена, 2);
        Т.Количество = Количество; Т.Цена = Цена; Т.Сумма = Итог - НДС; Т.СуммаНДС = НДС; Т.Всего = Итог; Т.НДС = Ставка;
        О.СуммаДокумента = Итог; О.Записать();
        Д = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
        Д.Наименование = "CODEX LEGACY CONTRACT"; Д.Владелец = О.Контрагент; Д.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
        Д.Организация = О.БанковскийСчетОрганизации.Владелец; Д.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643"); Д.Записать();
        М = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Договор.СоздатьМенеджерЗаписи(); М.ИдентификаторAmoCRM = О.IDСделкиAmo; М.Версия = 1; М.Договор = Д.Ссылка; М.Записать();
        AssertPrice(ТипЗнч(О.Ссылка.Договор) = Тип("Строка"), "Legacy string data was not preserved");
        AssertPrice(TeMa_СобытияСервера.TeMa_ДоговорЗаказа(О.Ссылка) = Д.Ссылка, "Legacy order mapping resolution failed");

        Тело = Новый Структура("order_id,amo_id,contract_number,contract_date", Строка(О.Ссылка.УникальныйИдентификатор()), О.IDСделкиAmo, "TEST-PRICE", "2026-10-26T00:00:00");
        ОтветД = ГенерацияДКПСоздатьДКП(JSONPrice(Тело));
        ДанныеД = ReadPrice(ОтветД);
        Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеД.Получить("contract_id")));
        AssertPrice(ТипЗнч(О.Ссылка.Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов"), "Contract did not persist as a reference");
        AssertPrice(О.Ссылка.Договор = Договор, "Order contract reference mismatch");
        AssertPrice(Договор.ад_Спецификация[0].Сумма = Итог И Договор.ад_Спецификация[0].СуммаНДС = НДС, "Contract specification VAT model mismatch");
        AssertPrice(Договор.Сумма = Итог, "Contract total differs from order");

        Тело = Новый Структура("order_id,amo_id", Строка(О.Ссылка.УникальныйИдентификатор()), О.IDСделкиAmo);
        ОтветС = ГенерацияСчетаСоздатьСчет(JSONPrice(Тело)); ДанныеС = ReadPrice(ОтветС);
        Счет = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеС.Получить("invoice_id")));
        AssertPrice(Счет.Проведен И Счет.СуммаДокумента = Итог И Счет.СуммаВключаетНДС, "Invoice status/total/VAT flag mismatch");
        AssertPrice(Счет.ДоговорКонтрагента = Договор, "Invoice contract link missing");
        AssertPrice(Счет.Товары[0].Сумма = Итог И Счет.Товары[0].СуммаНДС = НДС И Счет.Товары[0].Цена = Цена, "Invoice line amount/price/VAT mismatch");

        Тело.Вставить("contract_id", Строка(Договор.УникальныйИдентификатор()));
        ОтветУ = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); ДанныеУ = ReadPrice(ОтветУ);
        AssertPrice(ОтветУ.КодСостояния = 200, "UPD was not posted: " + ОтветУ.Тело);
        УПД = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеУ.Получить("delivery_id")));
        AssertPrice(УПД.Проведен И УПД.СуммаДокумента = Итог И УПД.СуммаВключаетНДС, "UPD header mismatch");
        AssertPrice(УПД.ДоговорКонтрагента = Договор И УПД.Контрагент = О.Контрагент, "UPD party/contract mismatch");
        AssertPrice(УПД.Товары[0].Цена = Цена И УПД.Товары[0].Количество = Количество И УПД.Товары[0].Сумма = Итог И УПД.Товары[0].СуммаНДС = НДС, "UPD row amount mismatch");
        Группа = Т.Номенклатура.НоменклатурнаяГруппа;
        AssertPrice(УПД.Товары[0].Субконто = Группа, "UPD group lost");
        Проводки = УПД.ПолучитьОбъект().Движения.Хозрасчетный; Проводки.Прочитать();
        Выручка = 0; Налог = 0; НалоговаяВыручка = 0; ЕстьГруппаДоход = Ложь; ЕстьГруппаРасход = Ложь;
        Для Каждого П Из Проводки Цикл
            Если П.СчетДт.Код = "62.01" И П.СчетКт.Код = "90.01.1" Тогда
                Выручка = Выручка + П.Сумма; НалоговаяВыручка = НалоговаяВыручка + П.СуммаНУКт;
                Для Каждого А Из П.СубконтоКт Цикл Если А.Значение = Группа Тогда ЕстьГруппаДоход = Истина; КонецЕсли; КонецЦикла;
            КонецЕсли;
            Если П.СчетДт.Код = "90.03" И П.СчетКт.Код = "68.02" Тогда Налог = Налог + П.Сумма; КонецЕсли;
            Если П.СчетДт.Код = "90.02.1" Тогда
                Для Каждого А Из П.СубконтоДт Цикл Если А.Значение = Группа Тогда ЕстьГруппаРасход = Истина; КонецЕсли; КонецЦикла;
            КонецЕсли;
        КонецЦикла;
        AssertPrice(Выручка = Итог И Налог = НДС И НалоговаяВыручка = Итог - НДС, "Posted receivable/VAT/net revenue mismatch");
        AssertPrice(ЕстьГруппаДоход И ЕстьГруппаРасход, "Accounting group missing");

        // A different buyer's contract must be rejected before creating another realization.
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Договор ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец <> &Покупатель И НЕ Д.ПометкаУдаления И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)");
        З.УстановитьПараметр("Покупатель", О.Контрагент); ВД = З.Выполнить().Выбрать(); AssertPrice(ВД.Следующий(), "No foreign contract fixture");
        AssertPrice(TeMa_СобытияСервера.TeMa_ДоговорЗаказа(О.Ссылка, Строка(Д.Ссылка.УникальныйИдентификатор())) = Д.Ссылка, "Explicit same-buyer contract did not override saved contract");
        Счетчик = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.РеализацияТоваровУслуг");
        ВК = Счетчик.Выполнить().Выбрать(); ВК.Следующий(); БылоДокументов = ВК.Количество;
        Тело.Вставить("contract_id", Строка(ВД.Договор.УникальныйИдентификатор()));
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Foreign buyer contract accepted");
        Тело.Вставить("contract_id", "bad-guid");
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Malformed contract ID accepted");
        Тело.Вставить("contract_id", Строка(Новый УникальныйИдентификатор));
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Nonexistent contract accepted");
        ВК = Счетчик.Выполнить().Выбрать(); ВК.Следующий(); AssertPrice(ВК.Количество = БылоДокументов, "Invalid contract created a realization");
        Р.Вставить("gross", Итог); Р.Вставить("vat", НДС); Р.Вставить("posted_receivable", Выручка); Р.Вставить("net_revenue", НалоговаяВыручка);
        Р.Вставить("contract_links", Истина); Р.Вставить("legacy_string_preserved", Истина); Р.Вставить("accounting_group", Истина);
        Р.passed = Истина;
        ОтменитьТранзакцию();
    Исключение
        Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Р.Вставить("failure", Текст);
    КонецПопытки;
    Возврат Р;
КонецФункции

Функция RunPriceTests() Экспорт
    Р = Новый Массив;
    Р.Добавить(PriceContractCase("vat_22_122_100x23", Перечисления.СтавкиНДС.НДС22_122, 100, 23, 414.75));
    Р.Добавить(PriceContractCase("vat_20_100x23", Перечисления.СтавкиНДС.НДС20, 100, 23, 383.33));
    Р.Добавить(PriceContractCase("no_vat_100x23", Перечисления.СтавкиНДС.БезНДС, 100, 23, 0));
    Р.Добавить(PriceContractCase("rounding_3x010", Перечисления.СтавкиНДС.НДС22_122, 3, 0.10, 0.05));
    Возврат JSONPrice(Р);
КонецФункции

Процедура Проверить(Условие, Сообщение)
    Если НЕ Условие Тогда
        ВызватьИсключение Сообщение;
    КонецЕсли;
КонецПроцедуры

Функция ЧислоРеализаций()
    З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.РеализацияТоваровУслуг");
    В = З.Выполнить().Выбрать(); В.Следующий();
    Возврат В.Количество;
КонецФункции

Функция ЧислоСвязей()
    З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений.TeMa_ИдентификаторыAmoCRM_УПД");
    В = З.Выполнить().Выбрать(); В.Следующий();
    Возврат В.Количество;
КонецФункции

Функция ТестJSON(Значение)
    П = Новый ЗаписьJSON; П.УстановитьСтроку(); ЗаписатьJSON(П, Значение);
    Возврат П.Закрыть();
КонецФункции

Функция ВыполнитьСценарий(Имя, Тело, Код, Режим = "", Образец = Неопределено, НомерСтроки = 1)
    Результат = Новый Структура("name,passed", Имя, Ложь);
    ТранзакционныйТест = Режим <> "different_groups";
    СозданныеОбъекты = Новый Массив;
    Если ТранзакционныйТест Тогда НачатьТранзакцию(); КонецЕсли;
    Попытка
        Если Образец <> Неопределено Тогда
            ИсходныйЗаказ = Образец.ПолучитьОбъект();
            ИсходнаяСтрока = ИсходныйЗаказ.Товары[НомерСтроки - 1];
            Заказ = ИсходныйЗаказ.Скопировать();
            Заказ.Дата = ТекущаяДата();
            Заказ.Товары.Очистить();
            Если Режим <> "empty_order" Тогда
                Стр = Заказ.Товары.Добавить();
                ЗаполнитьЗначенияСвойств(Стр, ИсходнаяСтрока);
                Если Режим = "missing_first" Тогда
                    Товар = Стр.Номенклатура.ПолучитьОбъект().Скопировать();
                    Товар.Наименование = "CODEX VERIFY EMPTY GROUP";
                    Товар.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.ПустаяСсылка();
                    Товар.Записать(); Стр.Номенклатура = Товар.Ссылка;
                КонецЕсли;
                Если Режим = "missing_second" ИЛИ Режим = "different_groups" Тогда
                    Вторая = Заказ.Товары.Добавить();
                    ЗаполнитьЗначенияСвойств(Вторая, ИсходнаяСтрока);
                    Товар = Вторая.Номенклатура.ПолучитьОбъект().Скопировать();
                    Товар.Наименование = "CODEX VERIFY SECOND PRODUCT";
                    Если Режим = "missing_second" Тогда
                        Товар.НоменклатурнаяГруппа = Справочники.НоменклатурныеГруппы.ПустаяСсылка();
                    Иначе
                        Группа = Справочники.НоменклатурныеГруппы.СоздатьЭлемент();
                        Группа.Наименование = "CODEX VERIFY SECOND GROUP";
                        Группа.Записать();
                        СозданныеОбъекты.Добавить(Группа.Ссылка);
                        Товар.НоменклатурнаяГруппа = Группа.Ссылка;
                    КонецЕсли;
                    Товар.Записать(); Вторая.Номенклатура = Товар.Ссылка;
                    СозданныеОбъекты.Добавить(Товар.Ссылка);
                КонецЕсли;
                Если Режим = "empty_product" Тогда
                    Заказ.Товары.Вставить(0);
                КонецЕсли;
            КонецЕсли;
            Заказ.Записать();
            СозданныеОбъекты.Добавить(Заказ.Ссылка);
            Тело = ТестJSON(Новый Структура("order_id,amo_id", Строка(Заказ.Ссылка.УникальныйИдентификатор()), "9900261026"));
        КонецЕсли;
        РеализацийДо = ЧислоРеализаций(); СвязейДо = ЧислоСвязей();
        Ответ = ГенерацияУПДСоздатьУПД(Тело);
        Результат.Вставить("code", Ответ.КодСостояния);
        Ч = Новый ЧтениеJSON; Ч.УстановитьСтроку(Ответ.Тело);
        Данные = ПрочитатьJSON(Ч, Истина); Ч.Закрыть();
        Если Ответ.КодСостояния >= 400 Тогда Результат.Вставить("error", Данные.Получить("error")); КонецЕсли;
        Если Код <> 0 Тогда
            Проверить(Ответ.КодСостояния = Код, "Unexpected HTTP status");
        Иначе
            Проверить(Ответ.КодСостояния = 200 ИЛИ Ответ.КодСостояния = 202, "Expected posted or draft response");
        КонецЕсли;
        Если Ответ.КодСостояния >= 400 Тогда
            Проверить(ЧислоРеализаций() = РеализацийДо, "Error created a realization");
            Проверить(ЧислоСвязей() = СвязейДо, "Error created a version mapping");
            Проверить(Данные.Получить("error") <> Неопределено, "Missing error body");
        Иначе
            Проверить(ЧислоРеализаций() = РеализацийДо + 1, "Unexpected number of realizations");
            Проверить(ЧислоСвязей() = СвязейДо + 1, "Missing version mapping");
            Реализация = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("delivery_id"))).ПолучитьОбъект();
            СозданныеОбъекты.Добавить(Реализация.Ссылка);
            ОжидаемыеСтроки = Заказ.Товары.Количество();
            Если Режим = "empty_product" Тогда ОжидаемыеСтроки = ОжидаемыеСтроки - 1; КонецЕсли;
            Проверить(Реализация.Товары.Количество() = ОжидаемыеСтроки, "Goods count changed");
            Проверить(Реализация.Контрагент = Заказ.Контрагент, "Counterparty changed");
            Проверить(Реализация.СуммаВключаетНДС, "VAT included flag lost");
            Проверить(Лев(Реализация.Номер, 4) = "АМО-", "Number prefix changed");
            Проверить(Данные.Получить("delivery_number") = Реализация.Номер, "Response number mismatch");
            Индекс = 0;
            Для Каждого Исх Из Заказ.Товары Цикл
                Если НЕ ЗначениеЗаполнено(Исх.Номенклатура) Тогда Продолжить; КонецЕсли;
                СтрР = Реализация.Товары[Индекс]; Индекс = Индекс + 1;
                Проверить(СтрР.Номенклатура = Исх.Номенклатура, "Product changed");
                Проверить(СтрР.Субконто = Исх.Номенклатура.НоменклатурнаяГруппа, "Wrong nomenclature group");
                Проверить(СтрР.Количество = Исх.Количество И СтрР.Цена = Исх.Цена И СтрР.Сумма = Исх.Всего, "Quantity/price/amount changed");
                Проверить(СтрР.СуммаНДС = Исх.СуммаНДС, "VAT amount changed");
                ОжидаемыйНДС = Исх.НДС;
                Если НЕ ЗначениеЗаполнено(ОжидаемыйНДС) Тогда ОжидаемыйНДС = Перечисления.СтавкиНДС.БезНДС; КонецЕсли;
                Проверить(СтрР.СтавкаНДС = ОжидаемыйНДС, "VAT rate changed");
                Проверить(СтрР.СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01"), "Inventory account changed");
                Проверить(СтрР.СчетДоходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1"), "Revenue account changed");
                Проверить(СтрР.СчетРасходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1"), "Expense account changed");
                Проверить(СтрР.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03"), "VAT account changed");
            КонецЦикла;
            Если Ответ.КодСостояния = 202 Тогда
                Проверить(Данные.Получить("status") = "draft" И НЕ Реализация.Проведен, "Draft semantics changed");
                Проверить(Данные.Получить("error_reason") <> Неопределено, "Missing posting failure reason");
            Иначе
                Проверить(Данные.Получить("status") = "posted" И Реализация.Проведен, "Posted semantics changed");
                Реализация.Движения.Хозрасчетный.Прочитать();
                Доход = Ложь; Расход = Ложь;
                Для Каждого Проводка Из Реализация.Движения.Хозрасчетный Цикл
                    Если Проводка.СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1") Тогда
                        Для Каждого Аналитика Из Проводка.СубконтоКт Цикл
                            Если Аналитика.Значение = Реализация.Товары[0].Субконто Тогда Доход = Истина; КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;
                    Если Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1") Тогда
                        Для Каждого Аналитика Из Проводка.СубконтоДт Цикл
                            Если Аналитика.Значение = Реализация.Товары[0].Субконто Тогда Расход = Истина; КонецЕсли;
                        КонецЦикла;
                    КонецЕсли;
                КонецЦикла;
                Проверить(Доход И Расход, "Group missing from 90.01.1 / 90.02.1 accounting entries");
                Результат.Вставить("accounting_groups_verified", Истина);
            КонецЕсли;
            Результат.Вставить("document_status", Данные.Получить("status"));
        КонецЕсли;
        Результат.passed = Истина;
        Если ТранзакционныйТест Тогда ОтменитьТранзакцию(); КонецЕсли;
    Исключение
        ТекстОшибкиТеста = ОписаниеОшибки();
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Результат.Вставить("failure", ТекстОшибкиТеста);
    КонецПопытки;
    Если НЕ ТранзакционныйТест Тогда
        Попытка
            Набор = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_УПД.СоздатьНаборЗаписей();
            Набор.Отбор.ИдентификаторAmoCRM.Установить("9900261026");
            Набор.Записать();
            ИндексУдаления = СозданныеОбъекты.Количество() - 1;
            Пока ИндексУдаления >= 0 Цикл
                СозданныеОбъекты[ИндексУдаления].ПолучитьОбъект().Удалить();
                ИндексУдаления = ИндексУдаления - 1;
            КонецЦикла;
            Проверить(ЧислоРеализаций() = РеализацийДо И ЧислоСвязей() = СвязейДо, "Fixture cleanup changed document/mapping counts");
            Результат.Вставить("fixtures_removed", Истина);
        Исключение
            Результат.passed = Ложь;
            Результат.Вставить("cleanup_failure", ОписаниеОшибки());
        КонецПопытки;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция RunAllTests() Экспорт
    ЗПроверка = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Найдено ИЗ РегистрСведений.TeMa_ИдентификаторыAmoCRM_УПД ГДЕ ИдентификаторAmoCRM = &ID");
    ЗПроверка.УстановитьПараметр("ID", "9900261026");
    Проверить(ЗПроверка.Выполнить().Пустой(), "Test amo_id already exists; choose a different fixture ID");
    Р = Новый Массив;
    Р.Добавить(ВыполнитьСценарий("empty_body", "", 400));
    Р.Добавить(ВыполнитьСценарий("invalid_json", "{", 400));
    Р.Добавить(ВыполнитьСценарий("json_array", "[]", 400));
    Р.Добавить(ВыполнитьСценарий("missing_order_id", "{}", 400));
    Р.Добавить(ВыполнитьСценарий("empty_order_id", "{""order_id"":"" ""}", 400));
    Р.Добавить(ВыполнитьСценарий("missing_amo_id", "{""order_id"":""bad""}", 400));
    Р.Добавить(ВыполнитьСценарий("invalid_order_guid", "{""order_id"":""bad"",""amo_id"":""9900261026""}", 400));
    Р.Добавить(ВыполнитьСценарий("unknown_order", "{""order_id"":""c86fb6cc-e5a3-4688-beb2-c5a8ac594ea7"",""amo_id"":""9900261026""}", 404));
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Заказ, Т.НомерСтроки КАК НомерСтроки ИЗ Документ.TeMa_ЗаказПокупателя.Товары КАК Т ГДЕ Т.Номенклатура.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка) И Т.Количество > 0 УПОРЯДОЧИТЬ ПО Т.Ссылка.Дата УБЫВ");
    В = З.Выполнить().Выбрать();
    Проверить(В.Следующий(), "No sample order with a filled product group");
    Для Каждого Режим Из СтрРазделить("normal,different_groups,missing_first,missing_second,empty_order,empty_product", ",") Цикл
        Код = 0;
        Если Режим = "missing_first" ИЛИ Режим = "missing_second" ИЛИ Режим = "empty_order" Тогда Код = 400; КонецЕсли;
        Если Режим = "different_groups" Тогда Код = 202; КонецЕсли;
        Р.Добавить(ВыполнитьСценарий(Режим, "", Код, Режим, В.Заказ, В.НомерСтроки));
    КонецЦикла;
    Возврат ТестJSON(Р);
КонецФункции


