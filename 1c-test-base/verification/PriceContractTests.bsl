Процедура AssertPrice(Условие, Сообщение)
    Если НЕ Условие Тогда ВызватьИсключение Сообщение; КонецЕсли;
КонецПроцедуры

Функция JSONPrice(Данные)
    З = Новый ЗаписьJSON; З.УстановитьСтроку(); ЗаписатьJSON(З, Данные); Возврат З.Закрыть();
КонецФункции

Функция ReadPrice(Ответ)
    Если Ответ.КодСостояния >= 400 Тогда ВызватьИсключение Ответ.Тело; КонецЕсли;
    Ч = Новый ЧтениеJSON; Ч.УстановитьСтроку(Ответ.Тело); Р = ПрочитатьJSON(Ч, Истина); Ч.Закрыть(); Возврат Р;
КонецФункции

Функция PriceContractCase(Имя, Ставка, Количество, Цена, НДС)
    Р = Новый Структура("name,passed", Имя, Ложь);
    НачатьТранзакцию();
    Попытка
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Заказ, Т.НомерСтроки КАК НомерСтроки ИЗ Документ.TeMa_ЗаказПокупателя.Товары КАК Т ГДЕ Т.Номенклатура.НоменклатурнаяГруппа <> ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка) И Т.Количество > 0 УПОРЯДОЧИТЬ ПО Т.Ссылка.Дата УБЫВ");
        В = З.Выполнить().Выбрать(); AssertPrice(В.Следующий(), "No source order");
        Исх = В.Заказ.ПолучитьОбъект(); С = Исх.Товары[В.НомерСтроки - 1];
        О = Исх.Скопировать(); О.Дата = ТекущаяДата(); О.IDСделкиAmo = "9900261027";
        О.Договор = "legacy"; О.Товары.Очистить(); Т = О.Товары.Добавить(); ЗаполнитьЗначенияСвойств(Т, С);
        Итог = Окр(Количество * Цена, 2);
        Т.Количество = Количество; Т.Цена = Цена; Т.Сумма = Итог - НДС; Т.СуммаНДС = НДС; Т.Всего = Итог; Т.НДС = Ставка;
        О.СуммаДокумента = Итог; О.Записать();
        Д = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
        Д.Наименование = "CODEX LEGACY CONTRACT"; Д.Владелец = О.Контрагент; Д.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
        Д.Организация = О.БанковскийСчетОрганизации.Владелец; Д.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643"); Д.Записать();
        М = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Договор.СоздатьМенеджерЗаписи(); М.ИдентификаторAmoCRM = О.IDСделкиAmo; М.Версия = 1; М.Договор = Д.Ссылка; М.Записать();
        AssertPrice(ТипЗнч(О.Ссылка.Договор) = Тип("Строка"), "Legacy string data was not preserved");
        AssertPrice(TeMa_СобытияСервера.TeMa_ДоговорЗаказа(О.Ссылка) = Д.Ссылка, "Legacy order mapping resolution failed");

        Тело = Новый Структура("order_id,amo_id,contract_number,contract_date", Строка(О.Ссылка.УникальныйИдентификатор()), О.IDСделкиAmo, "TEST-PRICE", "2026-10-26T00:00:00");
        ОтветД = ГенерацияДКПСоздатьДКП(JSONPrice(Тело));
        ДанныеД = ReadPrice(ОтветД);
        Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеД.Получить("contract_id")));
        AssertPrice(ТипЗнч(О.Ссылка.Договор) = Тип("СправочникСсылка.ДоговорыКонтрагентов"), "Contract did not persist as a reference");
        AssertPrice(О.Ссылка.Договор = Договор, "Order contract reference mismatch");
        AssertPrice(Договор.ад_Спецификация[0].Сумма = Итог И Договор.ад_Спецификация[0].СуммаНДС = НДС, "Contract specification VAT model mismatch");
        AssertPrice(Договор.Сумма = Итог, "Contract total differs from order");

        Тело = Новый Структура("order_id,amo_id", Строка(О.Ссылка.УникальныйИдентификатор()), О.IDСделкиAmo);
        ОтветС = ГенерацияСчетаСоздатьСчет(JSONPrice(Тело)); ДанныеС = ReadPrice(ОтветС);
        Счет = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеС.Получить("invoice_id")));
        AssertPrice(Счет.Проведен И Счет.СуммаДокумента = Итог И Счет.СуммаВключаетНДС, "Invoice status/total/VAT flag mismatch");
        AssertPrice(Счет.ДоговорКонтрагента = Договор, "Invoice contract link missing");
        AssertPrice(Счет.Товары[0].Сумма = Итог И Счет.Товары[0].СуммаНДС = НДС И Счет.Товары[0].Цена = Цена, "Invoice line amount/price/VAT mismatch");

        Тело.Вставить("contract_id", Строка(Договор.УникальныйИдентификатор()));
        ОтветУ = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); ДанныеУ = ReadPrice(ОтветУ);
        AssertPrice(ОтветУ.КодСостояния = 200, "UPD was not posted: " + ОтветУ.Тело);
        УПД = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеУ.Получить("delivery_id")));
        AssertPrice(УПД.Проведен И УПД.СуммаДокумента = Итог И УПД.СуммаВключаетНДС, "UPD header mismatch");
        AssertPrice(УПД.ДоговорКонтрагента = Договор И УПД.Контрагент = О.Контрагент, "UPD party/contract mismatch");
        AssertPrice(УПД.Товары[0].Цена = Цена И УПД.Товары[0].Количество = Количество И УПД.Товары[0].Сумма = Итог И УПД.Товары[0].СуммаНДС = НДС, "UPD row amount mismatch");
        Группа = Т.Номенклатура.НоменклатурнаяГруппа;
        AssertPrice(УПД.Товары[0].Субконто = Группа, "UPD group lost");
        Проводки = УПД.ПолучитьОбъект().Движения.Хозрасчетный; Проводки.Прочитать();
        Выручка = 0; Налог = 0; НалоговаяВыручка = 0; ЕстьГруппаДоход = Ложь; ЕстьГруппаРасход = Ложь;
        Для Каждого П Из Проводки Цикл
            Если П.СчетДт.Код = "62.01" И П.СчетКт.Код = "90.01.1" Тогда
                Выручка = Выручка + П.Сумма; НалоговаяВыручка = НалоговаяВыручка + П.СуммаНУКт;
                Для Каждого А Из П.СубконтоКт Цикл Если А.Значение = Группа Тогда ЕстьГруппаДоход = Истина; КонецЕсли; КонецЦикла;
            КонецЕсли;
            Если П.СчетДт.Код = "90.03" И П.СчетКт.Код = "68.02" Тогда Налог = Налог + П.Сумма; КонецЕсли;
            Если П.СчетДт.Код = "90.02.1" Тогда
                Для Каждого А Из П.СубконтоДт Цикл Если А.Значение = Группа Тогда ЕстьГруппаРасход = Истина; КонецЕсли; КонецЦикла;
            КонецЕсли;
        КонецЦикла;
        AssertPrice(Выручка = Итог И Налог = НДС И НалоговаяВыручка = Итог - НДС, "Posted receivable/VAT/net revenue mismatch");
        AssertPrice(ЕстьГруппаДоход И ЕстьГруппаРасход, "Accounting group missing");

        // A different buyer's contract must be rejected before creating another realization.
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Договор ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец <> &Покупатель И НЕ Д.ПометкаУдаления И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)");
        З.УстановитьПараметр("Покупатель", О.Контрагент); ВД = З.Выполнить().Выбрать(); AssertPrice(ВД.Следующий(), "No foreign contract fixture");
        AssertPrice(TeMa_СобытияСервера.TeMa_ДоговорЗаказа(О.Ссылка, Строка(Д.Ссылка.УникальныйИдентификатор())) = Д.Ссылка, "Explicit same-buyer contract did not override saved contract");
        Счетчик = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.РеализацияТоваровУслуг");
        ВК = Счетчик.Выполнить().Выбрать(); ВК.Следующий(); БылоДокументов = ВК.Количество;
        Тело.Вставить("contract_id", Строка(ВД.Договор.УникальныйИдентификатор()));
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Foreign buyer contract accepted");
        Тело.Вставить("contract_id", "bad-guid");
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Malformed contract ID accepted");
        Тело.Вставить("contract_id", Строка(Новый УникальныйИдентификатор));
        Ошибка = ГенерацияУПДСоздатьУПД(JSONPrice(Тело)); AssertPrice(Ошибка.КодСостояния = 400, "Nonexistent contract accepted");
        ВК = Счетчик.Выполнить().Выбрать(); ВК.Следующий(); AssertPrice(ВК.Количество = БылоДокументов, "Invalid contract created a realization");
        Р.Вставить("gross", Итог); Р.Вставить("vat", НДС); Р.Вставить("posted_receivable", Выручка); Р.Вставить("net_revenue", НалоговаяВыручка);
        Р.Вставить("contract_links", Истина); Р.Вставить("legacy_string_preserved", Истина); Р.Вставить("accounting_group", Истина);
        Р.passed = Истина;
        ОтменитьТранзакцию();
    Исключение
        Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Р.Вставить("failure", Текст);
    КонецПопытки;
    Возврат Р;
КонецФункции

Функция RunPriceTests() Экспорт
    Р = Новый Массив;
    Р.Добавить(PriceContractCase("vat_22_122_100x23", Перечисления.СтавкиНДС.НДС22_122, 100, 23, 414.75));
    Р.Добавить(PriceContractCase("vat_20_100x23", Перечисления.СтавкиНДС.НДС20, 100, 23, 383.33));
    Р.Добавить(PriceContractCase("no_vat_100x23", Перечисления.СтавкиНДС.БезНДС, 100, 23, 0));
    Р.Добавить(PriceContractCase("rounding_3x010", Перечисления.СтавкиНДС.НДС22_122, 3, 0.10, 0.05));
    Возврат JSONPrice(Р);
КонецФункции
