Процедура ОтправитьДанныеОбОплатеВоВнешнююСистему(СчетНаОплату, СуммаОплаты, Контрагент)
    
    // 1. Собираем данные в структуру для удобной работы в n8n/amo
    Данные = Новый Структура;
    Данные.Вставить("invoice_number", СчетНаОплату.Номер);
    Данные.Вставить("invoice_date", Формат(СчетНаОплату.Дата, "ДФ=yyyy-MM-dd"));
    Данные.Вставить("amount", СуммаОплаты);
    Данные.Вставить("client_inn", Контрагент.ИНН);
    Данные.Вставить("client_name", Строка(Контрагент));
    
    // 2. Превращаем структуру в JSON
    СтрокаJSON = "";
    Попытка
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Данные);
        СтрокаJSON = ЗаписьJSON.Закрыть();
    Исключение
        ЗаписьЖурналаРегистрации("ИнтеграцияWebhook", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка сериализации JSON: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    
    // 3. Настраиваем подключение (замени на свой адрес вебхука)
    // Например: n8n.tvoy-domen.ru /webhook/1c-payment
    АдресСервера = "n8n.tvoy-domen.ru"; 
    ПутьНаСервере = "/webhook/1c-payment";
    
    // Подключаемся по HTTPS (важно для современных вебхуков)
    ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
    HTTPСоединение = Новый HTTPСоединение(АдресСервера, 443, , , , 10, ЗащищенноеСоединение);
    
    HTTPЗапрос = Новый HTTPЗапрос(ПутьНаСервере);
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
    
    // 4. Отправляем запрос
    Попытка
        Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
        
        Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 201 Тогда
            // Логируем, если сервер ответил ошибкой
            ЗаписьЖурналаРегистрации("ИнтеграцияWebhook", УровеньЖурналаРегистрации.Предупреждение, , , "Неудачный статус ответа: " + Ответ.КодСостояния);
        КонецЕсли;
        
    Исключение
        // Логируем, если сервер вообще недоступен
        ЗаписьЖурналаРегистрации("ИнтеграцияWebhook", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка отправки POST-запроса: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры