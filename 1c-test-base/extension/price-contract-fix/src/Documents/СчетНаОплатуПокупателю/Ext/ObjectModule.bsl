&После("ОбработкаЗаполнения")
Процедура TeMa_ОбработкаЗаполнения(ДанныеЗаполнения, ТекстОшибки, СтандартнаяОбработка)
	
	// Проверяем, что документ вводится именно на основании нашего заказа из amoCRM
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.TeMa_ЗаказПокупателя") Тогда
		
		// 1. Заполняем шапку Счета через ЭтотОбъект
		ЭтотОбъект.Контрагент = ДанныеЗаполнения.Контрагент;
		
		// ИСПРАВЛЕНО: В 1С:Бухгалтерия 3.0 банковский счет документа хранится в реквизите "СтруктурнаяЕдиница"
		ЭтотОбъект.СтруктурнаяЕдиница = ДанныеЗаполнения.БанковскийСчетОрганизации;
		
		// Заполняем Организацию из владельца счета
		Если ЗначениеЗаполнено(ЭтотОбъект.СтруктурнаяЕдиница) Тогда
			ЭтотОбъект.Организация = ЭтотОбъект.СтруктурнаяЕдиница.Владелец;
		ИначеЕсли НЕ ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
			// Оставим типовое заполнение, если счет не передан
			ЭтотОбъект.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		// Договор хранится ссылкой; старые строковые заказы поддержаны через регистр amoCRM.
		ЭтотОбъект.ДоговорКонтрагента = TeMa_СобытияСервера.TeMa_ДоговорЗаказа(ДанныеЗаполнения);
		ЭтотОбъект.СуммаВключаетНДС = Истина;
		
		// 3. Заполняем табличную часть "Товары" через ЭтотОбъект
		ЭтотОбъект.Товары.Очистить();
		Для Каждого СтрокаЗаказа Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = ЭтотОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
			
			// В счетах 1С:Бухгалтерии есть обязательное поле "Содержание"
			НоваяСтрока.Содержание = СтрокаЗаказа.Номенклатура.НаименованиеПолное;
			Если ПустаяСтрока(НоваяСтрока.Содержание) Тогда
				НоваяСтрока.Содержание = СтрокаЗаказа.Номенклатура.Наименование;
			КонецЕсли;
			
			НоваяСтрока.Количество = СтрокаЗаказа.Количество;
			НоваяСтрока.Цена       = СтрокаЗаказа.Цена;
			НоваяСтрока.Сумма      = TeMa_СобытияСервера.TeMa_СуммаСтрокиСНДС(СтрокаЗаказа);
			НоваяСтрока.СтавкаНДС  = СтрокаЗаказа.НДС;
			НоваяСтрока.СуммаНДС   = СтрокаЗаказа.СуммаНДС;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры