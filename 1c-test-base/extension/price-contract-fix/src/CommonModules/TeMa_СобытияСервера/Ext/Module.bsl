
Процедура TeMa_ПриЗаписиКонтрагентаПриЗаписи(Источник, Отказ) Экспорт
	// Если запись отменена другими механизмами, ничего не делаем
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, что это не группа
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	// ПРОВЕРКА: Есть ли контрагент в регистре ИдентификаторыAmoCRM?
	// Делаем это через запрос, так как Источник.Ссылка уже записана в базу данных на этот момент
	ЗапросАмо = Новый Запрос;
	ЗапросАмо.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИдентификаторыAmoCRM.ИдентификаторAmoCRM КАК ИдентификаторAmoCRM
		|ИЗ
		|	РегистрСведений.TeMa_ИдентификаторыAmoCRM КАК ИдентификаторыAmoCRM
		|ГДЕ
		|	ИдентификаторыAmoCRM.Контрагент = &Контрагент";
	
	ЗапросАмо.УстановитьПараметр("Контрагент", Источник.Ссылка);
	РезультатЗапроса = ЗапросАмо.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// Если в регистре записи нет — по условию запрос делать не нужно, выходим
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	АмоИД = Выборка.ИдентификаторAmoCRM;
	
	// Передаем GUID контрагента и найденный amo_id в фоновое задание
	ПараметрыПроцедуры = Новый Массив;
	ПараметрыПроцедуры.Добавить(Строка(Источник.Ссылка.УникальныйИдентификатор()));
	ПараметрыПроцедуры.Добавить(АмоИД); // Передаем вторым параметром
	
	ФоновыеЗадания.Выполнить(
		"TeMa_СобытияСервера.ОтправитьКонтрагентаВAmoCRM", 
		ПараметрыПроцедуры, 
		, 
		"Интеграция amoCRM: Отправка контрагента " + Источник.ИНН
	);
КонецПроцедуры

Процедура ОтправитьКонтрагентаВAmoCRM(ИдентификаторКонтрагента, АмоИД) Экспорт
	
	СсылкаКонтрагента = Справочники.Контрагенты.ПолучитьСсылку(New УникальныйИдентификатор(ИдентификаторКонтрагента));
	
	Если СсылкаКонтрагента.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	// 1. Формируем JSON с актуальными данными из 1С
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("id",        ИдентификаторКонтрагента);
	СтруктураДанных.Вставить("amo_id",    АмоИД); // ДОБАВЛЕНО: Передаем ID из amoCRM
	СтруктураДанных.Вставить("inn",       СокрЛП(СсылкаКонтрагента.ИНН));
	СтруктураДанных.Вставить("kpp",       СокрЛП(СсылкаКонтрагента.КПП));
	СтруктураДанных.Вставить("name",      СсылкаКонтрагента.Наименование);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// 2. Настройка HTTP-соединения с amoCRM 	
	АдресСервераCRM = "n8n.24tema.ru"; 
	
	HTTPСоединение = Новый HTTPСоединение(АдресСервераCRM, 443, , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	// Формируем запрос к API amoCRM (к вебхук-приемнику в n8n)
	HTTPЗапрос = Новый HTTPЗапрос("/webhook/api/v4/companies/v1_listener");      
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Попытка
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("PATCH", HTTPЗапрос);
		
		// Логируем результат для диагностики
		Если HTTPОтвет.КодСтатуса <> 200 И HTTPОтвет.КодСтатуса <> 204 Тогда
			ЗаписьЖурналаРегистрации("Интеграция.amoCRM",
				УровеньЖурналаРегистрации.Ошибка,
				, ,
				"Ошибка отправки вебхука. Код статуса: " + HTTPОтвет.КодСтатуса + ". Ответ: " + HTTPОтвет.ПолучитьТелоКакСтроку());
		КонецЕсли;  
	Исключение
		ЗаписьЖурналаРегистрации("Интеграция.amoCRM",
			УровеньЖурналаРегистрации.Ошибка,
			, ,
			"Критическая ошибка сети при отправке контрагента: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры 


Процедура TeMa_ПриОплатеСчетаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	// Если документ не проводится, ничего не делаем
	Если Отказ Тогда 
		Возврат; 
	КонецЕсли;

	// Перебираем табличную часть расшифровки платежа
	Для Каждого СтрокаТЧ Из Источник.РасшифровкаПлатежа Цикл
		
		// Проверяем, что в строке указан именно счет на оплату
		Если ЗначениеЗаполнено(СтрокаТЧ.СчетНаОплату) И ТипЗнч(СтрокаТЧ.СчетНаОплату) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
			
			// 1. Формируем текст примечания
			ДатаОплаты  = Формат(Источник.Дата, "ДФ=dd.MM.yyyy"); // Дата документа оплаты
			НомерСчета  = СокрЛП(СтрокаТЧ.СчетНаОплату.Номер);
			СуммаОплаты = Формат(СтрокаТЧ.СуммаПлатежа, "ЧГ=0; ЧДЦ=2"); // Без пробелов, 2 знака после запятой
			
			ТекстПримечания = СтрШаблон("%1 была получена оплата по счету № %2 в размере %3 рублей", ДатаОплаты, НомерСчета, СуммаОплаты);
			
			// 2. Получаем ID сделки AmoCRM
			// ВАЖНО: Замените "IDСделки_amoCRM" на реальный реквизит счета или договора, где хранится ID сделки!
			ИДСделки = СтрокаТЧ.СчетНаОплату.IDСделки_amoCRM; 
			
			Если ЗначениеЗаполнено(ИДСделки) Тогда
				// Собираем полезную нагрузку
				ПараметрыAPI = Новый Структура;
				ПараметрыAPI.Вставить("LeadID", ИДСделки);
				ПараметрыAPI.Вставить("Text", ТекстПримечания);
	
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(ПараметрыAPI);
				
				// Запускаем фоновое задание, чтобы не тормозить транзакцию проведения 1С
				ФоновыеЗадания.Выполнить("TeMa_СобытияСервера.ОтправитьДанные", МассивПараметров);
			Иначе
				// Опционально: логируем, что счет оплачен, но ID сделки не найден
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры     


Процедура ОтправитьДанные(ПараметрыAPI) Экспорт
	
	// Получаем авторизационные данные из констант
	Субдомен = Константы.TeMa_ДоменнаяЗона.Получить();
	Токен    = Константы.TeMa_access_token.Получить();
	
	Если ПустаяСтрока(Субдомен) Или ПустаяСтрока(Токен) Тогда
		ЗаписьЖурналаРегистрации("Интеграция AmoCRM", УровеньЖурналаРегистрации.Ошибка,,, "Не заполнены константы домена или токена");
		Возврат;
	КонецЕсли;
	
	Сервер = Субдомен + ".amocrm.ru";
	// Подставляем ID сделки в URL (формат "ЧГ=0" убирает пробелы тысячников в ID)
	Ресурс = "/api/v4/leads/" + Формат(ПараметрыAPI.LeadID, "ЧГ=0") + "/notes";
	
	// Формируем структуру JSON для AmoCRM
	ПараметрыТекста  = Новый Структура("text", ПараметрыAPI.Text);
	ОбъектПримечания = Новый Структура("note_type, params", "common", ПараметрыТекста);
	
	МассивДанных = Новый Массив;
	МассивДанных.Добавить(ОбъектПримечания);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Инициализируем соединение по HTTPS
	HTTPСоединение = Новый HTTPСоединение(Сервер, 443,,,, 5, Новый ЗащищенноеСоединениеOpenSSL());
	
	HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
	// Добавляем токен в заголовки
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Попытка
		// Отправляем POST-запрос
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		// Логируем ошибку, если AmoCRM вернул статус, отличный от 200 (ОК)
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				"Интеграция AmoCRM", 
				УровеньЖурналаРегистрации.Ошибка,
				, 
				, 
				"Ошибка API (" + Ответ.КодСостояния + "): " + Ответ.ПолучитьТелоКакСтроку()
			);
		КонецЕсли;
		
	Исключение
		// Логируем ошибку сети/соединения
		ЗаписьЖурналаРегистрации(
			"Интеграция AmoCRM", 
			УровеньЖурналаРегистрации.Ошибка,
			, 
			, 
			ОписаниеОшибки()
		);
	КонецПопытки;

КонецПроцедуры



// Заказ хранит сумму без НДС в Сумма, а сумму к оплате — в Всего.
// В типовых документах с СуммаВключаетНДС = Истина требуется именно Всего.
Функция TeMa_СуммаСтрокиСНДС(СтрокаЗаказа) Экспорт
    Возврат Окр(СтрокаЗаказа.Всего, 2);
КонецФункции

Функция TeMa_ДоговорПодходитПокупателю(Договор, Контрагент)
    Если ТипЗнч(Договор) <> Тип("СправочникСсылка.ДоговорыКонтрагентов") ИЛИ НЕ ЗначениеЗаполнено(Договор) Тогда
        Возврат Ложь;
    КонецЕсли;
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Ссылка = &Договор И Д.Владелец = &Контрагент И НЕ Д.ПометкаУдаления И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)");
    З.УстановитьПараметр("Договор", Договор);
    З.УстановитьПараметр("Контрагент", Контрагент);
    Возврат НЕ З.Выполнить().Пустой();
КонецФункции

Функция TeMa_ДоговорЗаказа(Заказ, ContractID = Неопределено) Экспорт
    // Явный выбор в виджете имеет приоритет; чужой договор не подменяется другим.
    Если ContractID <> Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(ContractID))) Тогда
        Попытка
            Выбранный = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрЛП(Строка(ContractID))));
        Исключение
            ВызватьИсключение "Некорректный GUID договора";
        КонецПопытки;
        Если НЕ TeMa_ДоговорПодходитПокупателю(Выбранный, Заказ.Контрагент) Тогда
            ВызватьИсключение "Выбранный договор не найден или не принадлежит покупателю заказа";
        КонецЕсли;
        Возврат Выбранный;
    КонецЕсли;

    // Новые заказы сохраняют ссылку. Старые строковые значения остаются в базе.
    Если TeMa_ДоговорПодходитПокупателю(Заказ.Договор, Заказ.Контрагент) Тогда
        Возврат Заказ.Договор;
    КонецЕсли;

    // Для старых заказов восстанавливаем связь по amo_id, а не по обрезанному имени.
    Если НЕ ПустаяСтрока(СокрЛП(Заказ.IDСделкиAmo)) Тогда
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Р.Договор КАК Договор ИЗ РегистрСведений.TeMa_ИдентификаторыAmoCRM_Договор КАК Р ГДЕ Р.ИдентификаторAmoCRM = &ID И Р.Договор.Владелец = &Контрагент И НЕ Р.Договор.ПометкаУдаления И Р.Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем) УПОРЯДОЧИТЬ ПО Р.Версия УБЫВ");
        З.УстановитьПараметр("ID", Заказ.IDСделкиAmo);
        З.УстановитьПараметр("Контрагент", Заказ.Контрагент);
        В = З.Выполнить().Выбрать();
        Если В.Следующий() Тогда Возврат В.Договор; КонецЕсли;
    КонецЕсли;

    // Сохраняем прежний запасной выбор "Без договора", затем договора покупателя.
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Договор, ВЫБОР КОГДА Д.Наименование ПОДОБНО ""%Без договора%"" ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Приоритет ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Контрагент И НЕ Д.ПометкаУдаления И Д.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем) УПОРЯДОЧИТЬ ПО Приоритет, Д.Код");
    З.УстановитьПараметр("Контрагент", Заказ.Контрагент);
    В = З.Выполнить().Выбрать();
    Если В.Следующий() Тогда Возврат В.Договор; КонецЕсли;
    Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
КонецФункции
