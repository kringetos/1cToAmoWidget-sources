&НаСервере
Процедура СформироватьPDFВФоне(Параметры, АдресРезультата) Экспорт
    // 1. Получаем объект обработки
    ОбработкаОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(Параметры.СсылкаНаДопОбработку);
    
    // 2. Имитируем БСП-коллекцию
    МассивОбъектов = Новый Массив;
    МассивОбъектов.Добавить(Параметры.СсылкаНаДоговор);
    Коллекция = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(Параметры.РеальныйИдентификатор);
    
    // 3. Вызываем штатный метод Печать (теперь он не упадет, так как это фоновый процесс)
    ОбработкаОбъект.Печать(МассивОбъектов, Коллекция, Новый СписокЗначений, Новый Структура);
    
    // 4. Берем результат
    ТабДок = Коллекция[0].ТабличныйДокумент;
    ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
    ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
    
    // 5. Помещаем данные во временное хранилище, чтобы сервис их забрал
    Данные = Новый ДвоичныеДанные(ИмяФайла);
    Адрес = ПоместитьВоВременноеХранилище(Данные);
    УдалитьФайлы(ИмяФайла);
    
    // Передаем адрес результата обратно в сервис
    АдресРезультата = Адрес;
КонецПроцедуры

