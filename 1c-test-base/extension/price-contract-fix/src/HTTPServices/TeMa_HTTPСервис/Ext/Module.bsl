Процедура ЗаписатьЛогAPI(Эндпоинт, Метод, КодОтвета, ТелоЗапроса = "", ТелоОтвета = "", ТекстОшибки = "", AmoID = "") Экспорт
	
	МенеджерЗаписи = РегистрыСведений.TeMa_ЛогиAPI.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЛога = Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.ДатаВремя         = ТекущаяДата();
	МенеджерЗаписи.Эндпоинт          = Эндпоинт;
	МенеджерЗаписи.Метод             = Метод;
	МенеджерЗаписи.КодОтвета         = КодОтвета;
	МенеджерЗаписи.AmoID             = AmoID;
	МенеджерЗаписи.ТелоЗапроса       = ТелоЗапроса;
	МенеджерЗаписи.ТелоОтвета        = ТелоОтвета;
	МенеджерЗаписи.ТекстОшибки       = ТекстОшибки;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ЛогированиеAPI.ОшибкаЗаписи", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

//Получение номенклатуры (GET)
Функция НоменклатураПолучитьНоменклатуру(Запрос) 
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем параметры запроса
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	СтрокаПоиска   = ПараметрыЗапроса.Получить("search");
	Идентификатор  = ПараметрыЗапроса.Получить("id");
	
	// Получаем лимит из запроса или ставим 50 по умолчанию
	СтрокаЛимит = ПараметрыЗапроса.Получить("limit");
	Лимит = ?(ЗначениеЗаполнено(СтрокаЛимит), Число(СтрокаЛимит), 50);
	
	// Получаем смещение (offset) из запроса или ставим 0 по умолчанию
	СтрокаСмещение = ПараметрыЗапроса.Получить("offset");
	Смещение = ?(ЗначениеЗаполнено(СтрокаСмещение), Число(СтрокаСмещение), 0);
	
	// 2. Строим запрос к базе данных 1С с динамическим ограничением ПЕРВЫЕ
	// Берем с запасом, чтобы гарантированно захватить нужный кусок для пагинации
	МаксимальноеКоличество = Лимит + Смещение;
	
	ШаблонЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа";
	
	ТекстЗапроса = СтрШаблон(ШаблонЗапроса, Формат(МаксимальноеКоличество, "ЧГ=0"));
	
	// Добавляем фильтры в зависимости от параметров
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Номенклатура.Ссылка = &Ссылка";
	ИначеЕсли ЗначениеЗаполнено(СтрокаПоиска) Тогда
		ТекстЗапроса = ТекстЗапроса + " И (Номенклатура.Наименование ПОДОБНО &СтрокаПоиска ИЛИ Номенклатура.Артикул ПОДОБНО &СтрокаПоиска)";
	КонецЕсли;
	
	// Сортировка обязательна для корректной работы лимитов
	ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Номенклатура.Наименование";
	
	ЗапросБД = Новый Запрос(ТекстЗапроса);
	
	// Установка параметров
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Попытка
			СсылкаGUID = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			ЗапросБД.УстановитьПараметр("Ссылка", СсылкаGUID);
		Исключение
			Ответ.КодСтатуса = 400;
			Ответ.УстановитьТелоИзСтроки("{""error"": ""Некорректный формат GUID""}");
			Возврат Ответ;
		КонецПопытки;
	ИначеЕсли ЗначениеЗаполнено(СтрокаПоиска) Тогда
		ЗапросБД.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
	КонецЕсли;
	
	// 3. Выполняем запрос и выгружаем в таблицу для точечного обхода диапазона
	МассивНоменклатуры = Новый Массив;
	РезультатЗапроса = ЗапросБД.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ТаблицаДанных = РезультатЗапроса.Выгрузить();
		
		// Вычисляем границы индексов для обхода таблицы (в 1С индексация с 0)
		ИндексНачала = Смещение; 
		ИндексКонца  = Мин(ТаблицаДанных.Количество() - 1, Смещение + Лимит - 1);
		
		// Перебираем только строки, попавшие в нужный диапазон пагинации
		Для Индекс = ИндексНачала По ИндексКонца Цикл
			
			СтрокаДанных = ТаблицаДанных[Индекс];
			
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("id",        Строка(СтрокаДанных.Ссылка.УникальныйИдентификатор()));
			// По ТЗ в sku пишем артикул. Если он пустой — можно подтягивать код как фолбек
			СтруктураТовара.Вставить("sku",       ?(ЗначениеЗаполнено(СтрокаДанных.Артикул), СокрЛП(СтрокаДанных.Артикул), СокрЛП(СтрокаДанных.Код))); 
			СтруктураТовара.Вставить("name",      СтрокаДанных.Наименование);
			СтруктураТовара.Вставить("uom",       Строка(СтрокаДанных.ЕдиницаИзмерения));
			СтруктураТовара.Вставить("art",       СокрЛП(СтрокаДанных.Артикул));
			СтруктураТовара.Вставить("vat_rate",  "20%"); 
			
			МассивНоменклатуры.Добавить(СтруктураТовара);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 4. Сериализация в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивНоменклатуры);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	УстановитьЗаголовкиCORS(Ответ); // <-- Добавили перед возвратом
	Возврат Ответ;   
КонецФункции

//Получение Складов (GET)
Функция СкладыПолучитьСклады(Запрос)
Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		
	// 1. Строим запрос к справочнику Склады
	// Исключаем группы и отбираем только те, что относятся к основной организации
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.Код КАК Код,
	|	Склады.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";
	
	ЗапросБД = Новый Запрос(ТекстЗапроса);
	
	// 2. Выполняем запрос и формируем массив структур для JSON
	МассивСкладов = Новый Массив;
	Выборка = ЗапросБД.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураСклада = Новый Структура;
		СтруктураСклада.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		СтруктураСклада.Вставить("code", СокрЛП(Выборка.Код));
		СтруктураСклада.Вставить("name", Выборка.Наименование);
		
		МассивСкладов.Добавить(СтруктураСклада);
		
	КонецЦикла;
	
	// 3. Сериализация в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивСкладов);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

//Получение Банковских счетов (GET)
Функция БанковскиеСчетаПолучитьСчета(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем параметры фильтрации
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	IDОрганизации   = ПараметрыЗапроса.Получить("organization_id");
	
	// 2. Строим запрос к справочнику БанковскиеСчета
	// Защищаем поля от NULL с помощью ЕСТЬNULL
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(БанковскиеСчета.Наименование, """") КАК Наименование,
	|	ЕСТЬNULL(БанковскиеСчета.НомерСчета, """") КАК НомерСчета,
	|	ЕСТЬNULL(БанковскиеСчета.Банк.Наименование, """") КАК БанкНаименование,
	|	ЕСТЬNULL(БанковскиеСчета.Банк.Код, """") КАК БИК,
	|	БанковскиеСчета.Владелец КАК Организация
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец ССЫЛКА Справочник.Организации"; // <-- Жесткий фильтр по типу владельца
	
	// Если передан GUID конкретной организации, фильтруем дополнительно по ней
	Если ЗначениеЗаполнено(IDОрганизации) Тогда
		ТекстЗапроса = ТекстЗапроса + " И БанковскиеСчета.Владелец = &ОрганизацияВладелец";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО БанковскиеСчета.Наименование";
	
	ЗапросБД = Новый Запрос(ТекстЗапроса);
	
	// Установка параметров
	Если ЗначениеЗаполнено(IDОрганизации) Тогда
		Попытка
			СсылкаОрганизация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(IDОрганизации));
			ЗапросБД.УстановитьПараметр("ОрганизацияВладелец", СсылкаОрганизация);
		Исключение
			Ответ.КодСтатуса = 400;
			Ответ.УстановитьТелоИзСтроки("{""error"": ""Некорректный формат GUID организации""}");
			Возврат Ответ;
		КонецПопытки;
	КонецЕсли;
	
	// 3. Выполняем запрос и формируем JSON
	МассивСчетов = Новый Массив;
	Выборка = ЗапросБД.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураСчета = Новый Структура;
		СтруктураСчета.Вставить("id",              Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		СтруктураСчета.Вставить("name",            Строка(Выборка.Наименование));
		СтруктураСчета.Вставить("account_number",  СокрЛП(Выборка.НомерСчета));
		СтруктураСчета.Вставить("bank_name",       Строка(Выборка.БанкНаименование));
		СтруктураСчета.Вставить("bik",             СокрЛП(Выборка.БИК));
		
		// Безопасное извлечение GUID организации (владельца)
		Если ЗначениеЗаполнено(Выборка.Организация) Тогда
			GUIDОрганизации = Строка(Выборка.Организация.УникальныйИдентификатор());
		Иначе
			GUIDОрганизации = "";
		КонецЕсли;
		
		СтруктураСчета.Вставить("organization_id", GUIDОрганизации);
		
		МассивСчетов.Добавить(СтруктураСчета);
		
	КонецЦикла;
	
	// 4. Сериализация
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивСчетов);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
	
КонецФункции

//Синхронизация контрагента (POST)
Функция КонтрагентыСинхронизироватьКонтрагента(Запрос) 
Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Читаем и парсим входящий JSON
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 2. Получаем данные контрагента из корня JSON
	АмоИДКонтрагента = СокрЛП(Строка(Данные.Получить("amo_id")));
	ИННКонтрагента   = СокрЛП(Строка(Данные.Получить("inn")));
	КППКонтрагента   = СокрЛП(Строка(Данные.Получить("kpp")));
	ИмяКонтрагента   = СокрЛП(Строка(Данные.Получить("name")));
	
	Если ПустаяСтрока(АмоИДКонтрагента) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	
	НайденныйКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	// 3. ШАГ 1: Ищем контрагента по amo_id в регистре сведений
	ЗапросКонтрагент = Новый Запрос;
	ЗапросКонтрагент.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИдентификаторыAmoCRM.Контрагент КАК Ссылка
		|ИЗ
		|	РегистрСведений.TeMa_ИдентификаторыAmoCRM КАК ИдентификаторыAmoCRM
		|ГДЕ
		|	ИдентификаторыAmoCRM.ИдентификаторAmoCRM = &АмоИД";
	ЗапросКонтрагент.УстановитьПараметр("АмоИД", АмоИДКонтрагента);
	
	РезультатКонтрагент = ЗапросКонтрагент.Выполнить();
	
	Если НЕ РезультатКонтрагент.Пустой() Тогда
		// Контрагент уже связан с этим amo_id
		Выборка = РезультатКонтрагент.Выбрать();
		Выборка.Следующий();
		НайденныйКонтрагент = Выборка.Ссылка;
	Иначе
		// 4. ШАГ 2: Ищем по ИНН и КПП в справочнике (чтобы не дублировать)
		Если ЗначениеЗаполнено(ИННКонтрагента) Тогда
			ЗапросИНН = Новый Запрос;
			
			// Динамически формируем запрос: КПП ищем только если он передан
			ТекстЗапросаИНН = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Контрагенты.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.ИНН = &ИНН
				|	И НЕ Контрагенты.ПометкаУдаления";
				
			Если ЗначениеЗаполнено(КППКонтрагента) Тогда
				ТекстЗапросаИНН = ТекстЗапросаИНН + " И Контрагенты.КПП = &КПП";
				ЗапросИНН.УстановитьПараметр("КПП", КППКонтрагента);
			КонецЕсли;
			
			ЗапросИНН.Текст = ТекстЗапросаИНН;
			ЗапросИНН.УстановитьПараметр("ИНН", ИННКонтрагента);
			
			РезультатИНН = ЗапросИНН.Выполнить();
			Если НЕ РезультатИНН.Пустой() Тогда
				ВыборкаИНН = РезультатИНН.Выбрать();
				ВыборкаИНН.Следующий();
				НайденныйКонтрагент = ВыборкаИНН.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		// 5. ШАГ 3: Если по ИНН тоже не нашли — создаем нового
		Если НЕ ЗначениеЗаполнено(НайденныйКонтрагент) Тогда
			НовКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовКонтрагент.Наименование = ?(ЗначениеЗаполнено(ИмяКонтрагента), ИмяКонтрагента, "Контрагент из AmoCRM " + АмоИДКонтрагента);
			НовКонтрагент.ИНН = ИННКонтрагента;
			НовКонтрагент.КПП = КППКонтрагента;
			
			// Автоматически определяем Юр/Физ лицо по длине ИНН
			Если СтрДлина(ИННКонтрагента) = 10 Тогда
				НовКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
			ИначеЕсли СтрДлина(ИННКонтрагента) = 12 Тогда
				НовКонтрагент.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
			КонецЕсли;
			
			Попытка
				НовКонтрагент.Записать();
				НайденныйКонтрагент = НовКонтрагент.Ссылка;
			Исключение
				Возврат ОшибкаJSON(Ответ, 500, "Ошибка при создании нового контрагента: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		// 6. ШАГ 4: Записываем связку в регистр (если нашли по ИНН или создали нового)
		Попытка
			МенеджерЗаписиAmo = РегистрыСведений.TeMa_ИдентификаторыAmoCRM.СоздатьМенеджерЗаписи();
			МенеджерЗаписиAmo.ИдентификаторAmoCRM = АмоИДКонтрагента;
			МенеджерЗаписиAmo.Контрагент = НайденныйКонтрагент;
			МенеджерЗаписиAmo.Записать();
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Ошибка при записи в регистр идентификаторов AmoCRM: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
	// 7. Формируем успешный ответ с ID найденного/созданного контрагента
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("status", "success");
	СтруктураОтвета.Вставить("contractor_1c_id", Строка(НайденныйКонтрагент.УникальныйИдентификатор()));
	
	// Предполагается, что функция УспехJSON у вас уже есть в общем модуле
	Возврат УспехJSON(Ответ, СтруктураОтвета);	
КонецФункции

//Получение ставки НДС (GET)
Функция СтавкаНДСПолучитьНДС(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	МассивСтавок = Новый Массив;
	
	// ИСПРАВЛЕНО: Используем ЗначенияПеречисления вместо Значения
	Для Индекс = 0 По Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления.Количество() - 1 Цикл
		
		ИмяЗначения = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления[Индекс].Имя;
		СинонимЗначения = Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления[Индекс].Синоним;
		
		СтруктураСтавки = Новый Структура;
		СтруктураСтавки.Вставить("id", ИмяЗначения); 
		СтруктураСтавки.Вставить("name", СинонимЗначения);
		
		МассивСтавок.Добавить(СтруктураСтавки);
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивСтавок);
	
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть()); 
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

//Создание кастомного документа заказов покупателя (POST)
Функция ВходящиеСделкиСоздатьЗаказ(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Читаем и парсим входящий JSON
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Проверка обязательного поля
	AmoID = СокрЛП(Строка(Данные.Получить("amo_id")));
	Если ПустаяСтрока(AmoID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
    AmoID = СокрЛП(Строка(Данные.Получить("amo_id")));
	
	// 2. Определяем текущую версию сделки из регистра
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_ЗаказПокупателя КАК Рег
			|ГДЕ
			|	Рег.amo_id = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", AmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 3. Создание буферного документа TeMa_ЗаказПокупателя
	Попытка
		НовыйДок = Документы.TeMa_ЗаказПокупателя.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.IDСделкиAmo = AmoID;
		НовыйДок.ВходящийJSON = СтрокаJSON; // Сохраняем исходный JSON для отладки
		
		НовыйДок.АдресДоставки = СокрЛП(Строка(Данные.Получить("delivery_address")));
		Если Данные.Получить("total_sum") <> Неопределено Тогда
			НовыйДок.СуммаДокумента = Число(Данные.Получить("total_sum"));
		КонецЕсли;
		
		// 4. Заполнение ссылочных реквизитов шапки из GUID
		НовыйДок.Контрагент = ПолучитьСсылкуИзGUID(Справочники.Контрагенты, Данные.Получить("contractor_id"));
		НовыйДок.Склад = ПолучитьСсылкуИзGUID(Справочники.Склады, Данные.Получить("warehouse_id"));
		НовыйДок.БанковскийСчетОрганизации = ПолучитьСсылкуИзGUID(Справочники.БанковскиеСчета, Данные.Получить("bank_account_id"));
		
		// 5. Заполнение табличной части "Товары"
		МассивТоваров = Данные.Получить("products");
		Если ТипЗнч(МассивТоваров) = Тип("Массив") Тогда
			Для Каждого ТоварJSON Из МассивТоваров Цикл
				СтрокаТЧ = НовыйДок.Товары.Добавить();
				СтрокаТЧ.Номенклатура = ПолучитьСсылкуИзGUID(Справочники.Номенклатура, ТоварJSON.Получить("nomenclature_id"));
				
				СтрокаТЧ.Количество   = Число(ТоварJSON.Получить("quantity"));
				СтрокаТЧ.Цена         = Число(ТоварJSON.Получить("price"));
				СтрокаТЧ.Сумма        = Число(ТоварJSON.Получить("sum"));
				СтрокаТЧ.СуммаНДС     = Число(ТоварJSON.Получить("vat_sum"));
				СтрокаТЧ.Всего        = Число(ТоварJSON.Получить("total"));
				
				ИмяСтавки = Строка(ТоварJSON.Получить("vat_rate_id"));
				Если НЕ ПустаяСтрока(ИмяСтавки) Тогда
					Попытка
						СтрокаТЧ.НДС = XMLЗначение(Тип("ПеречислениеСсылка.СтавкиНДС"), ИмяСтавки);
					Исключение
						СтрокаТЧ.НДС = Перечисления.СтавкиНДС.БезНДС;
					КонецПопытки;
				Иначе
					СтрокаТЧ.НДС = Перечисления.СтавкиНДС.БезНДС;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Записываем документ
		НовыйДок.Записать(РежимЗаписиДокумента.Запись);
		
		// 6. ЗАПИСЬ В РЕГИСТР СВЕДЕНИЙ
		// Предполагается, что регистр независимый. Если подчинен регистратору, логика будет немного другой.
		МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_ЗаказПокупателя.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.amo_id = AmoID; // Имя поля в регистре может отличаться, проверьте в конфигураторе
		МенеджерЗаписи.Версия = НомерВерсии;
		МенеджерЗаписи.ЗаказПокупателя = НовыйДок.Ссылка;
		МенеджерЗаписи.Записать();
		
		// 7. Формируем успешный ответ
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("status", "created");
		СтруктураОтвета.Вставить("id", Строка(НовыйДок.Ссылка.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("version", НомерВерсии); // Добавил возврат версии в ответе на всякий случай
		
		Возврат УспехJSON(Ответ, СтруктураОтвета);
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка создания документа или записи в регистр: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Безопасное получение ссылки по GUID
Функция ПолучитьСсылкуИзGUID(МенеджерСправочника, СтрокаGUID)
	Если НЕ ЗначениеЗаполнено(СтрокаGUID) Тогда
		Возврат МенеджерСправочника.ПустаяСсылка();
	КонецЕсли;
	Возврат МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(СтрокаGUID)));
КонецФункции

// Генерация JSON с ошибкой
Функция ОшибкаJSON(Ответ, Код, Текст, ТелоЗапроса = "", Эндпоинт = "Неизвестно")
	Ответ.КодСостояния = Код; 
	УстановитьЗаголовкиCORS(Ответ);
	
	СтрокаОшибки = "{""error"": """ + СтрЗаменить(Текст, """", "\""") + """}";
	Ответ.УстановитьТелоИзСтроки(СтрокаОшибки);
	
	// Пишем в лог
	ЗаписатьЛогAPI(Эндпоинт, "POST/GET", Код, ТелоЗапроса, СтрокаОшибки, Текст);
	
	Возврат Ответ;КонецФункции

// Генерация успешного JSON ответа
Функция УспехJSON(Ответ, СтруктураДанных)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	УстановитьЗаголовкиCORS(Ответ); // <-- Добавили CORS
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Возврат Ответ;
КонецФункции   

// Создание счета на основе заказа покупателя (POST)
Функция ГенерацияСчетаСоздатьСчет(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Пустое тело запроса");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") И ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Ожидается JSON-объект");
	КонецЕсли;
	
	// 1. Получаем GUID нашего заказа из JSON
	ЗначениеID = Данные.Получить("order_id");
	Если ЗначениеID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	СтрокаGUID = СокрЛП(Строка(ЗначениеID));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Поле order_id не может быть пустым");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (укажите правильное имя поля из вашего JSON, например "amo_id")
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Документ.TeMa_ЗаказПокупателя КАК TeMa_ЗаказПокупателя
		|ГДЕ
		|	TeMa_ЗаказПокупателя.Ссылка = &Ссылка";
	ЗапросБД.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
	
	Если ЗапросБД.Выполнить().Пустой() Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;   
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_Счет КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем Счет на оплату
	НовыйСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	
	Попытка
		// Программный ввод на основании
		НовыйСчет.Заполнить(СсылкаНаЗаказ);
		НовыйСчет.Дата = ТекущаяДата();
		
		Если НЕ ЗначениеЗаполнено(НовыйСчет.Организация) Тогда
			НовыйСчет.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		// --- РУЧНАЯ ГЕНЕРАЦИЯ КАСТОМНОГО НОМЕРА (АМО-...) ---
		ПрефиксАМО = "АМО-";
		
		ДлинаНомера = Метаданные.Документы.СчетНаОплатуПокупателю.ДлинаНомера; 
		Если ДлинаНомера <= 0 Тогда 
			ДлинаНомера = 11;
		КонецЕсли;
		
		ЗапросНомер = Новый Запрос;
		ЗапросНомер.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Счет.Номер КАК Номер
			|ИЗ
			|	Документ.СчетНаОплатуПокупателю КАК Счет
			|ГДЕ
			|	Счет.Номер ПОДОБНО &Префикс
			|УПОРЯДОЧИТЬ ПО
			|	Номер УБЫВ";
		ЗапросНомер.УстановитьПараметр("Префикс", ПрефиксАМО + "%");
		
		Выборка = ЗапросНомер.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЧисловаяЧасть = Сред(Выборка.Номер, СтрДлина(ПрефиксАМО) + 1);
			Попытка
				СледующийНомер = Число(ЧисловаяЧасть) + 1;
			Исключение
				СледующийНомер = 1;
			КонецПопытки;
		Иначе
			СледующийНомер = 1;
		КонецЕсли;
		
		ДлинаЧисла = ДлинаНомера - СтрДлина(ПрефиксАМО);
		ФорматСтрока = "ЧЦ=" + ДлинаЧисла + "; ЧВН=; ЧГ=0";
		
		НовыйСчет.Номер = ПрефиксАМО + СтрЗаменить(Формат(СледующийНомер, ФорматСтрока), " ", "");
		// ----------------------------------------------------
		
		// Попытка проведения
		НовыйСчет.Записать(РежимЗаписиДокумента.Проведение);
		
		СтатусДокумента = "created";
		ОписаниеОшибкиПроведения = "";
		
	Исключение
		ОписаниеОшибкиПроведения = ОписаниеОшибки();
		СтатусДокумента = "draft";
		
		// Если не провелся — пишем как черновик
		Попытка
			НовыйСчет.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Критическая ошибка при записи черновика Счета: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;
	
	// ---> НОВОЕ: 3.1. Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_Счет"   
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Счет.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение    
		МенеджерЗаписи.Версия = НомерВерсии;
		МенеджерЗаписи.Счет = НовыйСчет.Ссылка;             // Ресурс (ссылка на сохраненный документ)
		МенеджерЗаписи.Записать();
	Исключение
		// Если по какой-то причине в регистр не записалось (например, дубль), вернем ошибку 500
		Возврат ОшибкаJSON(Ответ, 500, "Счет создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM: " + ОписаниеОшибки());
	КонецПопытки;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 4. Формируем ответ
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("status", СтатусДокумента);
	СтруктураОтвета.Вставить("invoice_id", Строка(НовыйСчет.Ссылка.УникальныйИдентификатор()));
	СтруктураОтвета.Вставить("invoice_number", НовыйСчет.Номер);
	
	Если СтатусДокумента = "draft" Тогда
		СтруктураОтвета.Вставить("error_reason", ОписаниеОшибкиПроведения);
		Ответ.КодСостояния = 202; // 202 Accepted
	КонецЕсли;
	
	Возврат УспехJSON(Ответ, СтруктураОтвета);
КонецФункции

//Получение PDF счета(GET)
Функция ПолучениеСчетаPDFСкачатьPDFСчета(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	
	// 1. Получаем относительный путь и вытаскиваем GUID
	ОтносительныйПуть = Запрос.ОтносительныйURL; 
	МассивЧастейУРЛ = СтрРазделить(ОтносительныйПуть, "/");

	СтрокаСтрокаGUID = "";
	КоличествоЭлементов = МассивЧастейУРЛ.Количество();

	Для Счетчик = 1 По КоличествоЭлементов Цикл
		Индекс = КоличествоЭлементов - Счетчик;
		ТекущаяЧасть = СокрЛП(МассивЧастейУРЛ[Индекс]);
		
		Если СтрДлина(ТекущаяЧасть) = 36 Тогда
			СтрокаСтрокаGUID = ТекущаяЧасть;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// 2. Получаем ссылку на документ
	Попытка
		СсылкаНаДокумент = Документы.СчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаСтрокаGUID));
		
		Если СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
			ВызватьИсключение "Документ с указанным GUID не найден.";
		КонецЕсли;
	Исключение
		Ответ.КодСостояния = 404;
		Ответ.УстановитьТелоИзСтроки("Ошибка: Неверный GUID или документ отсутствует.");
		Возврат Ответ;
	КонецПопытки;
	
	// 3. Вызываем функцию из модуля менеджера документа
	УстановитьПривилегированныйРежим(Истина);
	
	// Вызов функции через Менеджер документа
	ДвоичныеДанныеPDF = Документы.СчетНаОплатуПокупателю.ФайлПечатнойФормы(СсылкаНаДокумент, ТипФайлаТабличногоДокумента.PDF);
	
	Если ДвоичныеДанныеPDF <> Неопределено И ТипЗнч(ДвоичныеДанныеPDF) = Тип("ДвоичныеДанные") Тогда
		
		// Формируем успешный ответ
		Ответ.КодСостояния = 200;
		Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
		Ответ.Заголовки.Вставить("Content-Disposition", "inline; filename=""invoice.pdf"""); 
		Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеPDF);
		
	Иначе
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("Ошибка при генерации PDF через функцию менеджера документа.");
	КонецЕсли;
	
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции            

//Создание УПД (POST)
Функция ГенерацияУПДСоздатьУПД(Запрос) 
Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Пустое тело запроса");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") И ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Ожидается JSON-объект");
	КонецЕсли;
	
	// 1. Получаем GUID нашего заказа из JSON
	ЗначениеID = Данные.Получить("order_id");
	Если ЗначениеID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	СтрокаGUID = СокрЛП(Строка(ЗначениеID));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Поле order_id не может быть пустым");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (укажите правильное имя поля из вашего JSON, например "amo_id")
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	Документ.TeMa_ЗаказПокупателя КАК TeMa_ЗаказПокупателя
		|ГДЕ
		|	TeMa_ЗаказПокупателя.Ссылка = &Ссылка";
	ЗапросБД.УстановитьПараметр("Ссылка", СсылкаНаЗаказ);
	
	Если ЗапросБД.Выполнить().Пустой() Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_УПД КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем документ Реализация товаров и услуг
	НоваяРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	
	Попытка
		НоваяРеализация.Дата = ТекущаяДата();
		
		// --- 1. ПЕРЕНОСИМ КОНТРАГЕНТА И ПРОВЕРЯЕМ ЕГО ---
		НоваяРеализация.Контрагент = СсылкаНаЗаказ.Контрагент;
		
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Контрагент) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: В документе TeMa_ЗаказПокупателя не заполнен Контрагент!");
		КонецЕсли;
		
		// Договор из явного выбора, ссылки заказа или прежней связи amoCRM.
		Попытка
			СсылкаНаДоговор = TeMa_СобытияСервера.TeMa_ДоговорЗаказа(СсылкаНаЗаказ, Данные.Получить("contract_id"));
		Исключение
			Возврат ОшибкаJSON(Ответ, 400, ОписаниеОшибки());
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(СсылкаНаДоговор) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: У контрагента нет ни одного договора с видом 'С покупателем'.");
		КонецЕсли;
		
		НоваяРеализация.ДоговорКонтрагента = СсылкаНаДоговор;
		
		// --- 3. ЗАПОЛНЯЕМ ОСТАЛЬНЫЕ РЕКВИЗИТЫ ---
		НоваяРеализация.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Товары;
		НоваяРеализация.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("643"); // Рубли
		
		// ОБЯЗАТЕЛЬНЫЕ ФЛАГИ ДЛЯ КОРРЕКТНОЙ РАБОТЫ ФОРМЫ 1С
		НоваяРеализация.СуммаВключаетНДС = Истина;
		
		// Страховка Организации
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.БанковскийСчетОрганизации) Тогда
			НоваяРеализация.Организация = СсылкаНаЗаказ.БанковскийСчетОрганизации.Владелец;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Организация) Тогда
			НоваяРеализация.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяРеализация.Организация) Тогда
			Возврат ОшибкаJSON(Ответ, 400, "Критическая ошибка: Не удалось определить Организацию для Реализации.");
		КонецЕсли;		
		
		// Страховка Склада
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.Склад) Тогда
			НоваяРеализация.Склад = СсылкаНаЗаказ.Склад;
		Иначе
			НоваяРеализация.Склад = Справочники.Склады.НайтиПоНаименованию("Основной склад");
		КонецЕсли;
		
		// Заполняем Счета расчетов с контрагентом
		НоваяРеализация.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01");
		НоваяРеализация.СчетУчетаРасчетовПоАвансам = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02");
		
		// 4. ПЕРЕНОСИМ ТОВАРЫ
		Для Каждого СтрокаЗаказа Из СсылкаНаЗаказ.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			НовСтрока = НоваяРеализация.Товары.Добавить();
			НовСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
		// Номенклатурная группа для аналитики доходов и расходов.
		Попытка
			ГруппаНоменклатуры = НовСтрока.Номенклатура.НоменклатурнаяГруппа;
			НовСтрока.Субконто = ГруппаНоменклатуры;
		Исключение
			Возврат ОшибкаJSON(Ответ, 400,
				"Не удалось заполнить номенклатурную группу для товара "
				+ Строка(НовСтрока.Номенклатура) + ": " + ОписаниеОшибки());
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ГруппаНоменклатуры) Тогда
			Возврат ОшибкаJSON(Ответ, 400,
				"В карточке товара не заполнена номенклатурная группа: "
				+ Строка(НовСтрока.Номенклатура));
		КонецЕсли;
			НовСтрока.Количество   = СтрокаЗаказа.Количество;
			НовСтрока.Цена         = СтрокаЗаказа.Цена;
			НовСтрока.Сумма        = TeMa_СобытияСервера.TeMa_СуммаСтрокиСНДС(СтрокаЗаказа);
			НовСтрока.СуммаНДС     = СтрокаЗаказа.СуммаНДС;
			
			Если ЗначениеЗаполнено(СтрокаЗаказа.НДС) Тогда
				НовСтрока.СтавкаНДС = СтрокаЗаказа.НДС;
			Иначе
				НовСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; 
			КонецЕсли;
			
			НовСтрока.СчетУчета = ПланыСчетов.Хозрасчетный.НайтиПоКоду("41.01");
			НовСтрока.СчетДоходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.01.1");
			НовСтрока.СчетРасходов = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.02.1");
			НовСтрока.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.НайтиПоКоду("90.03");
		КонецЦикла;
		
		Если НоваяРеализация.Товары.Количество() = 0 Тогда
			Возврат ОшибкаJSON(Ответ, 400, "В заказе TeMa_ЗаказПокупателя нет товаров для переноса!");
		КонецЕсли;
		
		// --- 5. ГЕНЕРАЦИЯ НОМЕРА (АМО-...) ---
		ПрефиксАМО = "АМО-";
		ДлинаНомера = Метаданные.Документы.РеализацияТоваровУслуг.ДлинаНомера; 
		Если ДлинаНомера <= 0 Тогда 
			ДлинаНомера = 11;
		КонецЕсли;
		
		ЗапросНомер = Новый Запрос;
		ЗапросНомер.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Реализация.Номер КАК Номер
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК Реализация
			|ГДЕ
			|	Реализация.Номер ПОДОБНО &Префикс
			|УПОРЯДОЧИТЬ ПО
			|	Номер УБЫВ";
		ЗапросНомер.УстановитьПараметр("Префикс", ПрефиксАМО + "%");
		
		Выборка = ЗапросНомер.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЧисловаяЧасть = Сред(Выборка.Номер, СтрДлина(ПрефиксАМО) + 1);
			Попытка
				СледующийНомер = Число(ЧисловаяЧасть) + 1;
			Исключение
				СледующийНомер = 1;
			КонецПопытки;
		Иначе
			СледующийНомер = 1;
		КонецЕсли;
		
		ДлинаЧисла = ДлинаНомера - СтрДлина(ПрефиксАМО);
		ФорматСтрока = "ЧЦ=" + ДлинаЧисла + "; ЧВН=; ЧГ=0";
		НоваяРеализация.Номер = ПрефиксАМО + СтрЗаменить(Формат(СледующийНомер, ФорматСтрока), " ", "");
				
		// 6. ПОПЫТКА ПРОВЕДЕНИЯ
		НоваяРеализация.Записать(РежимЗаписиДокумента.Проведение);
		
		СтатусДокумента = "posted";
		ОписаниеОшибкиПроведения = "";
	Исключение
		ПолныйТекстОшибки = ОписаниеОшибки();
		
		ПозицияОшибки = Найти(ПолныйТекстОшибки, "}:");
		Если ПозицияОшибки > 0 Тогда
			ОписаниеОшибкиПроведения = СокрЛП(Сред(ПолныйТекстОшибки, ПозицияОшибки + 2));
		Иначе
			ОписаниеОшибкиПроведения = ПолныйТекстОшибки;
		КонецЕсли;
		
		СтатусДокумента = "draft";
		
		Попытка
			НоваяРеализация.Записать(РежимЗаписиДокумента.Запись);
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Критическая ошибка при записи черновика Реализации: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;
	
	// ---> НОВОЕ: 6.1. Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_УПД"
	Попытка
		МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_УПД.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение     
		МенеджерЗаписи.Версия = НомерВерсии; // Измерение
		МенеджерЗаписи.УПД = НоваяРеализация.Ссылка;        // Ресурс (обрати внимание, здесь реквизит называется УПД)
		МенеджерЗаписи.Записать();
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "УПД создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM_УПД: " + ОписаниеОшибки());
	КонецПопытки;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 4. Формируем ответ
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("status", СтатусДокумента);
	СтруктураОтвета.Вставить("delivery_id", Строка(НоваяРеализация.Ссылка.УникальныйИдентификатор()));
	СтруктураОтвета.Вставить("delivery_number", НоваяРеализация.Номер);
	
	Если СтатусДокумента = "draft" Тогда
		СтруктураОтвета.Вставить("error_reason", ОписаниеОшибкиПроведения);
		Ответ.КодСостояния = 202; 
	КонецЕсли;
	
	Возврат УспехJSON(Ответ, СтруктураОтвета);
КонецФункции	

// Создание Договора купли-продажи на основании Заказа (POST)
Функция ГенерацияДКПСоздатьДКП(Запрос)
Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	// 1. Получаем GUID нашего заказа из JSON
	СтрокаGUID = СокрЛП(Строка(Данные.Получить("order_id")));
	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле order_id");
	КонецЕсли;
	
	// ---> НОВОЕ: Получаем ID из AmoCRM (нужен для записи в регистр)
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	// <--- КОНЕЦ НОВОГО БЛОКА
	
	// 2. Ищем документ TeMa_ЗаказПокупателя в базе
	Попытка
		УИД_Заказа = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаЗаказ = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД_Заказа);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Передан некорректный формат GUID (order_id)");
	КонецПопытки;
	
	Если СсылкаНаЗаказ.ПолучитьОбъект() = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Документ TeMa_ЗаказПокупателя с таким ID не найден в базе 1С");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаЗаказ.Контрагент) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "В заказе не заполнен Контрагент. Невозможно создать договор.");
	КонецЕсли;
	
	НомерВерсии = 1;
	Попытка
		ЗапросВерсия = Новый Запрос;
		ЗапросВерсия.Текст = 
			"ВЫБРАТЬ
			|	ЕСТЬNULL(МАКСИМУМ(Рег.Версия), 0) КАК ТекущаяВерсия
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_ЗаказПокупателя КАК Рег
			|ГДЕ
			|	Рег.amo_id = &AmoID";
		ЗапросВерсия.УстановитьПараметр("AmoID", ЗначениеAmoID);
		
		ВыборкаВерсии = ЗапросВерсия.Выполнить().Выбрать();
		Если ВыборкаВерсии.Следующий() Тогда
			НомерВерсии = ВыборкаВерсии.ТекущаяВерсия + 1;
		КонецЕсли;
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при расчете версии из регистра: " + ОписаниеОшибки());
	КонецПопытки;

	
	// 3. Создаем новый элемент справочника "Договоры контрагентов"
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		
		НовыйДоговор.Владелец = СсылкаНаЗаказ.Контрагент;
		НовыйДоговор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		
		Если ЗначениеЗаполнено(СсылкаНаЗаказ.БанковскийСчетОрганизации) Тогда
			НовыйДоговор.Организация = СсылкаНаЗаказ.БанковскийСчетОрганизации.Владелец;
		Иначе
			НовыйДоговор.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		КонецЕсли;
		
		НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");
		
		// --- НАИМЕНОВАНИЕ ДОГОВОРА ---
		СтрокаНаименование = Строка(Данные.Получить("contract_name"));
		Если ЗначениеЗаполнено(СтрокаНаименование) И СтрокаНаименование <> "Неопределено" Тогда
			НовыйДоговор.Наименование = СокрЛП(СтрокаНаименование);
		Иначе
			НовыйДоговор.Наименование = "Договор купли продажи AmoCRM";
		КонецЕсли;
		
		// --- НОМЕР И ДАТА ДОГОВОРА ---
		СтрокаНомерДоговора = Строка(Данные.Получить("contract_number"));
		Если ЗначениеЗаполнено(СтрокаНомерДоговора) И СтрокаНомерДоговора <> "Неопределено" Тогда
			НовыйДоговор.Номер = СокрЛП(СтрокаНомерДоговора);
		Иначе
			НовыйДоговор.Номер = Строка(СсылкаНаЗаказ.Номер); 
		КонецЕсли;
		
		ЗначениеДатаДоговора = Данные.Получить("contract_date");
		Если ЗначениеДатаДоговора <> Неопределено Тогда
			Попытка
				НовыйДоговор.Дата = XMLЗначение(Тип("Дата"), Строка(ЗначениеДатаДоговора));
			Исключение
				НовыйДоговор.Дата = ТекущаяДата();
			КонецПопытки;
		Иначе
			НовыйДоговор.Дата = ТекущаяДата();
		КонецЕсли;
		
		НовыйДоговор.СуммаВключаетНДС = Истина;
		
		Если СсылкаНаЗаказ.Товары.Количество() > 0 Тогда
			НовыйДоговор.СтавкаНДС = СсылкаНаЗаказ.Товары[0].НДС;
		КонецЕсли;

		Попытка
			НовыйДоговор.СпособВыставленияДокументов = Перечисления.СпособыВыставленияДокументов.Автоматически;
		Исключение
		КонецПопытки;

		Попытка
			НовыйДоговор.Руководитель = Справочники.ФизическиеЛица.НайтиПоНаименованию("Иванов Павел Викторович"); 
			СсылкаНаДолжность = Справочники.Должности.НайтиПоНаименованию("Директор");
			Если ЗначениеЗаполнено(СсылкаНаДолжность) Тогда
				НовыйДоговор.ДолжностьРуководителя = СсылкаНаДолжность;
			КонецЕсли;
		Исключение
		КонецПопытки;

		СтрокаФИО = Строка(Данные.Получить("counterparty_director"));
		Если ЗначениеЗаполнено(СтрокаФИО) И СтрокаФИО <> "Неопределено" Тогда
			НовыйДоговор.РуководительКонтрагента = СокрЛП(СтрокаФИО);
		Иначе
			НовыйДоговор.РуководительКонтрагента = СсылкаНаЗаказ.Контрагент.Наименование;
		КонецЕсли;

		СтрокаДолжность = Строка(Данные.Получить("counterparty_position"));
		Если ЗначениеЗаполнено(СтрокаДолжность) И СтрокаДолжность <> "Неопределено" Тогда
			НовыйДоговор.ДолжностьРуководителяКонтрагента = СокрЛП(СтрокаДолжность);
		Иначе
			НовыйДоговор.ДолжностьРуководителяКонтрагента = "Генеральный директор"; 
		КонецЕсли;
		
		СтрокаОснование = Строка(Данные.Получить("counterparty_acting_on_basis"));
		Если ЗначениеЗаполнено(СтрокаОснование) И СтрокаОснование <> "Неопределено" Тогда
			НовыйДоговор.ад_Устав = СокрЛП(СтрокаОснование); 
		КонецЕсли;

		Попытка
			ЗначениеСуммаПредоплаты = Данные.Получить("prepayment_amount");
			Если ЗначениеСуммаПредоплаты <> Неопределено Тогда
				НовыйДоговор.ад_СуммаПредоплаты = Число(ЗначениеСуммаПредоплаты);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаПредоплаты", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеСрокОтгрузки = Данные.Получить("delivery_term");
			Если ЗначениеСрокОтгрузки <> Неопределено Тогда
				НовыйДоговор.ад_СрокОтгрузки = Число(ЗначениеСрокОтгрузки); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаСрокаОтгрузки", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеСрокГарантии = Данные.Получить("warranty_term");
			Если ЗначениеСрокГарантии <> Неопределено Тогда
				НовыйДоговор.ад_СрокГарантии = Число(ЗначениеСрокГарантии); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаСрокаГарантии", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			ЗначениеОбъемСУГ = Данные.Получить("sug_volume");
			Если ЗначениеОбъемСУГ <> Неопределено Тогда
				НовыйДоговор.ад_ОбъемСУГ = Число(ЗначениеОбъемСУГ); 
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ГенерацияДКП.ОшибкаОбъемаСУГ", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
		КонецПопытки;

		Попытка
			НовыйДоговор.Сумма = СсылкаНаЗаказ.СуммаДокумента;
		Исключение
		КонецПопытки;

		Для Каждого СтрокаЗаказа Из СсылкаНаЗаказ.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;

			НовСтрока = НовыйДоговор.ад_Спецификация.Добавить(); 
			НовСтрока.Номенклатура = СтрокаЗаказа.Номенклатура;
			НовСтрока.Количество   = СтрокаЗаказа.Количество;
			НовСтрока.Цена         = СтрокаЗаказа.Цена;
			НовСтрока.Сумма        = TeMa_СобытияСервера.TeMa_СуммаСтрокиСНДС(СтрокаЗаказа);
			НовСтрока.СуммаНДС     = СтрокаЗаказа.СуммаНДС;
			
			Попытка
				НовСтрока.Всего = СтрокаЗаказа.Всего; 
			Исключение
			КонецПопытки;
			
			Если ЗначениеЗаполнено(СтрокаЗаказа.НДС) Тогда
				НовСтрока.СтавкаНДС = СтрокаЗаказа.НДС;
			Иначе
				НовСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС; 
			КонецЕсли;
		КонецЦикла;
		
		НовыйДоговор.Записать();
		
		// 4. ПРИВЯЗЫВАЕМ ДОГОВОР К ЗАКАЗУ
		ОбъектЗаказа = СсылкаНаЗаказ.ПолучитьОбъект();
		ОбъектЗаказа.Договор = НовыйДоговор.Ссылка;
		ОбъектЗаказа.Записать(РежимЗаписиДокумента.Запись); 
		
		// ---> НОВОЕ: Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_Договор"
		Попытка
			МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Договор.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение     
			МенеджерЗаписи.Версия = НомерВерсии; // Измерение
			МенеджерЗаписи.Договор = НовыйДоговор.Ссылка;       // Ресурс (ссылка на сохраненный договор)
			МенеджерЗаписи.Записать();
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Договор создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM_Договор: " + ОписаниеОшибки());
		КонецПопытки;
		// <--- КОНЕЦ НОВОГО БЛОКА
		
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("status", "created");
		СтруктураОтвета.Вставить("contract_id", Строка(НовыйДоговор.Ссылка.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("contract_name", НовыйДоговор.Наименование);
		
		Возврат УспехJSON(Ответ, СтруктураОтвета);
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при создании Договора: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

//Получение PDF договоров
Функция ПолучениеPDFДоговораСкачатьPDF(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	ИмяВременногоФайлаEPF = "";
	ИмяВременногоФайлаPDF = "";
	
	Попытка
		// 1. Получаем параметры из запроса
		СтрокаGUID = Запрос.ПараметрыЗапроса.Получить("guid");
		ТипФормы = Запрос.ПараметрыЗапроса.Получить("type");
		
		Если ПустаяСтрока(СтрокаGUID) Или ПустаяСтрока(ТипФормы) Тогда
			ВызватьИсключение "Не указаны обязательные параметры 'guid' или 'type'.";
		КонецЕсли;

		// 2. Получаем ссылку на договор 
		// (Внимание: проверьте, что тип документа указан верно. Обычно это Справочники.ДоговорыКонтрагентов)
		СсылкаНаДокумент = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаGUID));
			
		Если СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
			ВызватьИсключение "Договор с указанным GUID не найден.";
		КонецЕсли;

		// 3. Включаем полные права для чтения настроек и работы с файлами
		УстановитьПривилегированныйРежим(Истина); 
		
		// 4. Получаем настройки по нашему GUID
		GUIDНастроек = Новый УникальныйИдентификатор("9ce326ef-6883-11f1-8fb8-9191d9d2cb38");
		СсылкаНаНастройки = Справочники.TeMa_НастройкиПечатиДоговоров.ПолучитьСсылку(GUIDНастроек);
		
		ОбъектНастроек = СсылкаНаНастройки.ПолучитьОбъект();
		Если ОбъектНастроек = Неопределено Тогда
			ВызватьИсключение "Не найден элемент настроек печати договоров.";
		КонецЕсли;
		
		// 5. Выбираем нужную обработку
		СсылкаНаОбработку = ?(ТипФормы = "1", ОбъектНастроек.ОбработкаТип1, ОбъектНастроек.ОбработкаТип2);
		
		Если Не ЗначениеЗаполнено(СсылкаНаОбработку) Тогда
			ВызватьИсключение "В настройках не выбрана обработка для type=" + ТипФормы;
		КонецЕсли;
		
		// 6. Достаем .epf файл из базы и сохраняем во временный файл
		ДвоичныеДанныеОбработки = СсылкаНаОбработку.ХранилищеОбработки.Получить();
		Если ТипЗнч(ДвоичныеДанныеОбработки) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "В выбранной настройке нет файла обработки (.epf).";
		КонецЕсли;

		АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеОбработки);

		// Подключаем внешнюю обработку прямо из памяти (без файлов на диске)
		ИмяВнешнейОбработки = ВнешниеОбработки.Подключить(АдресХранилища, , Ложь); 
		ОбъектОбработки = ВнешниеОбработки.Создать(ИмяВнешнейОбработки);
		// Вызываем нашу идеальную функцию из объекта обработки:
		
		
		ДвоичныеДанныеPDF = ОбъектОбработки.ПолучитьPDFДляAPI(СсылкаНаДокумент);
		
		
		Ответ.КодСостояния = 200;
		Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
		Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеPDF);
		// 9. Формируем успешный ответ
		Ответ.КодСостояния = 200;
		Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
		Ответ.Заголовки.Вставить("Content-Disposition", "inline; filename=""contract.pdf"""); 
		Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеPDF);
		
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("Ошибка генерации PDF: " + ОписаниеОшибки());
	КонецПопытки;
	
	// Обязательная очистка мусора за собой, независимо от ошибок
	Попытка
		Если ЗначениеЗаполнено(ИмяВременногоФайлаPDF) Тогда 
			УдалитьФайлы(ИмяВременногоФайлаPDF); 
		КонецЕсли;
	Исключение
		// Игнорируем ошибки при удалении временных файлов
	КонецПопытки;
	
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

//Ping тест
Функция ТестированиеСвязиPingTest(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки("OK");  
	
	УстановитьЗаголовкиCORS(Ответ);
    Возврат Ответ;
КонецФункции

//Генерация ДП
Функция ГенерацияДПСоздатьДП(Запрос)
Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON");
	КонецПопытки;
	
	// 1. Получаем amo_id Контрагента из JSON
	ЗначениеAmoID = Данные.Получить("amo_id");
	Если ЗначениеAmoID = Неопределено ИЛИ ПустаяСтрока(Строка(ЗначениеAmoID)) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательное поле amo_id");
	КонецЕсли;
	
	// 2. Ищем Контрагента в регистре сведений TeMa_ИдентификаторыAmoCRM
	ЗапросКРегистру = Новый Запрос;
	ЗапросКРегистру.Текст = 
		"ВЫБРАТЬ
		|	TeMa_ИдентификаторыAmoCRM.Контрагент КАК Контрагент
		|ИЗ
		|	РегистрСведений.TeMa_ИдентификаторыAmoCRM КАК TeMa_ИдентификаторыAmoCRM
		|ГДЕ
		|	TeMa_ИдентификаторыAmoCRM.ИдентификаторAmoCRM = &ИдентификаторAmoCRM";
	
	ЗапросКРегистру.УстановитьПараметр("ИдентификаторAmoCRM", ЗначениеAmoID);
	
	РезультатЗапроса = ЗапросКРегистру.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Контрагент с amo_id '" + Строка(ЗначениеAmoID) + "' не найден в регистре 1С (TeMa_ИдентификаторыAmoCRM).");
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	СсылкаНаКонтрагента = Выборка.Контрагент;
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаКонтрагента) Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Запись с amo_id найдена, но Контрагент не заполнен.");
	КонецЕсли;
	
	// 3. Создаем новый элемент справочника "Договоры контрагентов"
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		
		НовыйДоговор.Владелец = СсылкаНаКонтрагента;
		НовыйДоговор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		
		НовыйДоговор.Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
		НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("643");
		
		// --- НАИМЕНОВАНИЕ ДОГОВОРА ---
		СтрокаНаименование = Строка(Данные.Получить("contract_name"));
		Если ЗначениеЗаполнено(СтрокаНаименование) И СтрокаНаименование <> "Неопределено" Тогда
			НовыйДоговор.Наименование = СокрЛП(СтрокаНаименование);
		Иначе
			НовыйДоговор.Наименование = "Договор поставки AmoCRM";
		КонецЕсли;
		
		// --- НОМЕР И ДАТА ДОГОВОРА ---
		СтрокаНомерДоговора = Строка(Данные.Получить("contract_number"));
		Если ЗначениеЗаполнено(СтрокаНомерДоговора) И СтрокаНомерДоговора <> "Неопределено" Тогда
			НовыйДоговор.Номер = СокрЛП(СтрокаНомерДоговора);
		КонецЕсли;
		
		ЗначениеДатаДоговора = Данные.Получить("contract_date");
		Если ЗначениеДатаДоговора <> Неопределено Тогда
			Попытка
				НовыйДоговор.Дата = XMLЗначение(Тип("Дата"), Строка(ЗначениеДатаДоговора));
			Исключение
				НовыйДоговор.Дата = ТекущаяДата();
			КонецПопытки;
		Иначе
			НовыйДоговор.Дата = ТекущаяДата();
		КонецЕсли;

		// --- СРОК ДЕЙСТВИЯ ДОГОВОРА ---
		ЗначениеСрокДействия = Данные.Получить("contract_expiration_date");
		Если ЗначениеСрокДействия <> Неопределено Тогда
			Попытка
				НовыйДоговор.СрокДействия = XMLЗначение(Тип("Дата"), Строка(ЗначениеСрокДействия));
			Исключение
				ЗаписьЖурналаРегистрации("ГенерацияДП.ОшибкаСрокДействия", УровеньЖурналаРегистрации.Предупреждение,,, ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		НовыйДоговор.СуммаВключаетНДС = Истина;
		
		СтрокаНДС = Строка(Данные.Получить("vat_rate"));
		Если ЗначениеЗаполнено(СтрокаНДС) Тогда
			Попытка
				НовыйДоговор.СтавкаНДС = Перечисления.СтавкиНДС[СтрокаНДС];
			Исключение
			КонецПопытки;
		КонецЕсли;

		Попытка
			НовыйДоговор.СпособВыставленияДокументов = Перечисления.СпособыВыставленияДокументов.Автоматически;
		Исключение
		КонецПопытки;

		Попытка
			НовыйДоговор.Руководитель = Справочники.ФизическиеЛица.НайтиПоНаименованию("Иванов Павел Викторович"); 
			СсылкаНаДолжность = Справочники.Должности.НайтиПоНаименованию("Директор");
			Если ЗначениеЗаполнено(СсылкаНаДолжность) Тогда
				НовыйДоговор.ДолжностьРуководителя = СсылкаНаДолжность;
			КонецЕсли;
		Исключение
		КонецПопытки;

		СтрокаФИО = Строка(Данные.Получить("counterparty_director"));
		Если ЗначениеЗаполнено(СтрокаФИО) И СтрокаФИО <> "Неопределено" Тогда
			НовыйДоговор.РуководительКонтрагента = СокрЛП(СтрокаФИО);
		Иначе
			НовыйДоговор.РуководительКонтрагента = СсылкаНаКонтрагента.Наименование;
		КонецЕсли;

		СтрокаДолжность = Строка(Данные.Получить("counterparty_position"));
		Если ЗначениеЗаполнено(СтрокаДолжность) И СтрокаДолжность <> "Неопределено" Тогда
			НовыйДоговор.ДолжностьРуководителяКонтрагента = СокрЛП(СтрокаДолжность);
		Иначе
			НовыйДоговор.ДолжностьРуководителяКонтрагента = "Генеральный директор"; 
		КонецЕсли;
		
		СтрокаОснование = Строка(Данные.Получить("counterparty_acting_on_basis"));
		Если ЗначениеЗаполнено(СтрокаОснование) И СтрокаОснование <> "Неопределено" Тогда
			НовыйДоговор.ад_Устав = СокрЛП(СтрокаОснование); 
		КонецЕсли;

		Попытка
			ЗначениеПредмет = Данные.Получить("contract_subject");
			Если ЗначениеПредмет <> Неопределено Тогда
				НовыйДоговор.ад_ПредметДоговора = СокрЛП(Строка(ЗначениеПредмет));
			КонецЕсли;
		Исключение
		КонецПопытки;
			
		Попытка
			ЗначениеСрокПоставки = Данные.Получить("delivery_date");
			Если ЗначениеСрокПоставки <> Неопределено Тогда
				НовыйДоговор.ад_СрокПоставки = XMLЗначение(Тип("Дата"), Строка(ЗначениеСрокПоставки));
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		ЗначениеСуммы = Данные.Получить("contract_amount");
		Если ЗначениеСуммы <> Неопределено Тогда
			НовыйДоговор.Сумма = Число(ЗначениеСуммы);
		КонецЕсли;
		
		// Сохраняем карточку договора
		НовыйДоговор.Записать();
		
		// ---> НОВОЕ: Делаем запись в регистр сведений "TeMa_ИдентификаторыAmoCRM_Договор"
		Попытка
			МенеджерЗаписи = РегистрыСведений.TeMa_ИдентификаторыAmoCRM_Договор.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ИдентификаторAmoCRM = ЗначениеAmoID; // Измерение
			МенеджерЗаписи.Договор = НовыйДоговор.Ссылка;       // Ресурс (ссылка на сохраненный договор)
			МенеджерЗаписи.Записать();
		Исключение
			Возврат ОшибкаJSON(Ответ, 500, "Договор создан, но возникла ошибка записи в регистр ИдентификаторыAmoCRM_Договор: " + ОписаниеОшибки());
		КонецПопытки;
		// <--- КОНЕЦ НОВОГО БЛОКА
		
		// Возвращаем успешный ответ
		СтруктураОтвета = Новый Структура;
		СтруктураОтвета.Вставить("status", "created");
		СтруктураОтвета.Вставить("contract_id", Строка(НовыйДоговор.Ссылка.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("contract_name", НовыйДоговор.Наименование);
		
		Возврат УспехJSON(Ответ, СтруктураОтвета);
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при создании Договора поставки: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// GET-запрос для поиска контрагента по amo_id
Функция КонтрагентыПолучитьКонтрагента(Запрос)
	// Получаем amo_id
	АмоИД = СокрЛП(Запрос.ПараметрыЗапроса.Получить("amo_id"));
	
	// 1. Проверка параметра
	Если НЕ ЗначениеЗаполнено(АмоИД) Тогда
		Ответ = Новый HTTPСервисОтвет(400); // Создаем ответ сразу с кодом 400
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("{""error"": ""Не передан параметр amo_id""}");
		Возврат Ответ;
	КонецЕсли;
	
	// 2. Ищем контрагента в БД
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИдентификаторыAmoCRM.Контрагент КАК Ссылка,
		|	ИдентификаторыAmoCRM.Контрагент.Наименование КАК Наименование
		|ИЗ
		|	РегистрСведений.TeMa_ИдентификаторыAmoCRM КАК ИдентификаторыAmoCRM
		|ГДЕ
		|	ИдентификаторыAmoCRM.ИдентификаторAmoCRM = &АмоИД";
	
	ЗапросБД.УстановитьПараметр("АмоИД", АмоИД);
	РезультатЗапроса = ЗапросБД.Выполнить();
	
	СтруктураОтвета = Новый Структура;
	КодОтвета = 200; // По умолчанию 200 OK
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		СтруктураОтвета.Вставить("status", "found");
		СтруктураОтвета.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		СтруктураОтвета.Вставить("name", Выборка.Наименование);
	Иначе
		КодОтвета = 404; // Меняем код, если не нашли
		СтруктураОтвета.Вставить("status", "not_found");
		СтруктураОтвета.Вставить("error", "Контрагент с указанным amo_id не найден");
	КонецЕсли;
	
	// 3. Формируем и возвращаем ответ
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

// Получение PDF УПД (GET)
Функция ПолучениеУПДPDFСкачатьPDFУПД(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	
	// 1. Получаем относительный путь и вытаскиваем GUID
	ОтносительныйПуть = Запрос.ОтносительныйURL; 
	МассивЧастейУРЛ = СтрРазделить(ОтносительныйПуть, "/");

	СтрокаGUID = "";
	КоличествоЭлементов = МассивЧастейУРЛ.Количество();

	Для Счетчик = 1 По КоличествоЭлементов Цикл
		Индекс = КоличествоЭлементов - Счетчик;
		ТекущаяЧасть = СокрЛП(МассивЧастейУРЛ[Индекс]);
		
		Если СтрДлина(ТекущаяЧасть) = 36 Тогда
			СтрокаGUID = ТекущаяЧасть;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// 2. Получаем ссылку на документ Реализации
	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаGUID);
		СсылкаНаДокумент = Документы.РеализацияТоваровУслуг.ПолучитьСсылку(УИД);
		
		Если СсылкаНаДокумент.ПолучитьОбъект() = Неопределено Тогда
			ВызватьИсключение "Документ с указанным GUID не найден.";
		КонецЕсли;
	Исключение
		Ответ.КодСостояния = 404;
		Ответ.УстановитьТелоИзСтроки("Ошибка: Неверный GUID или документ РеализацияТоваровУслуг отсутствует.");
		Возврат Ответ;
	КонецПопытки;
	
	// 3. Формируем печатную форму через стандартную обработку
	УстановитьПривилегированныйРежим(Истина);
	ТабДокумент = Неопределено;
	
	Попытка
		МассивОбъектов = Новый Массив;
		
		// Проверяем, есть ли связанный Счет-фактура, чтобы получить УПД в Статусе "1"
		ЗапросСФ = Новый Запрос;
		ЗапросСФ.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СчетФактура.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.СчетФактураВыданный КАК СчетФактура
			|ГДЕ
			|	СчетФактура.ДокументОснование = &Реализация
			|	И НЕ СчетФактура.ПометкаУдаления";
		ЗапросСФ.УстановитьПараметр("Реализация", СсылкаНаДокумент);
		ВыборкаСФ = ЗапросСФ.Выполнить().Выбрать();
		
		Если ВыборкаСФ.Следующий() Тогда
			// Для Статуса 1 типовая обработка ожидает в массиве именно Счет-Фактуру
			МассивОбъектов.Добавить(ВыборкаСФ.Ссылка);
		Else
			// Если СФ нет, печатаем Статус 2 (только передаточный документ) по самой Реализации
			МассивОбъектов.Добавить(СсылкаНаДокумент);
		КонецЕсли;
		
		// Подготавливаем параметры для БСП
		ПараметрыПечати = Новый Структура;
		ОбъектыПечати   = Новый СписокЗначений;
		ПараметрыВывода = Новый Структура;
		
		// РЕШЕНИЕ ПРОБЛЕМЫ С ИД: Динамически собираем все актуальные ИД макетов для УПД
		ТаблицаМакетовУПД = УчетНДС.ТаблицаМакетовУПД();
		МассивИДМакетов = Новый Массив;
		Для Каждого МакетУПД Из ТаблицаМакетовУПД Цикл
			МассивИДМакетов.Добавить(МакетУПД.ИДМакета);
		КонецЦикла;
		СтрокаМакетов = СтрСоединить(МассивИДМакетов, ",");
		
		// Инициализируем коллекцию точными именами макетов, которые понимает обработка ПечатьУПД
		КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(СтрокаМакетов);
		
		ПараметрыВывода = Новый Структура;
		// ВКЛЮЧАЕМ ФАКСИМИЛЕ:
		ПараметрыВывода.Вставить("ИспользоватьФаксимиле", Истина);
		
		// Вызываем процедуру печати
		Обработки.ПечатьУПД.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
		// Вызываем процедуру печати из менеджера найденной обработки
		Обработки.ПечатьУПД.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
		// Ищем РЕАЛЬНО заполненный ТабличныйДокумент в коллекции
		Для Каждого СтрокаКоллекции Из КоллекцияПечатныхФорм Цикл
			
			Если СтрокаКоллекции.ТабличныйДокумент <> Неопределено 
			   И ТипЗнч(СтрокаКоллекции.ТабличныйДокумент) = Тип("ТабличныйДокумент") Тогда
				
				// ПРОВЕРКА НА ПУСТОЙ ЛИСТ: 
				// Игнорируем исторические макеты, которые не прошли фильтр по дате документа
				Если СтрокаКоллекции.ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
					ТабДокумент = СтрокаКоллекции.ТабличныйДокумент;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТабДокумент = Неопределено Тогда
			ВызватьИсключение "Типовая обработка БСП вернула пустой табличный документ.";
		КонецЕсли; 
		// 3.5. ОТКЛЮЧАЕМ РАМКИ ПРИ ПЕЧАТИ
// Вместо перебора ячеек, мы говорим табличному документу 
// не выводить линии сетки и границы ячеек при сохранении в PDF.
ТабДокумент.ОтображатьСетку = Ложь;
ТабДокумент.ОтображатьЗаголовки = Ложь;

// Если рамки всё равно есть, значит они прописаны в макете как "стиль ячейки".
// Но для PDF-экспорта этого обычно достаточно.

// 3.6. АВТОМАТИЧЕСКАЯ ВСТАВКА ФАКСИМИЛЕ (И ОЧИСТКА РАМОК)
// Мы имитируем вызов типовой процедуры, которую ты нашел
Попытка
    // Подготавливаем структуру данных для вставки подписей
    ДанныеПечати = УправлениеПечатью.ПодписиИПечатиТабличногоДокумента(ОбъектыПечати, ТабДокумент, ТекущийЯзык());
    
    // ВАЖНО: Вызов штатной процедуры, которая сама уберет рамки и вставит подписи
    УправлениеПечатью.ДобавитьПодписьИПечать(ТабДокумент, ДанныеПечати);
Исключение
    // Если факсимиле не настроено, процедура может выдать ошибку — просто игнорируем
    // и оставляем как есть (с рамками)
КонецПопытки;
		// 4. Конвертация Табличного документа в ДвоичныеДанные (PDF)
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("pdf");
		
	
		ТабДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
		
		ДвоичныеДанныеPDF = Новый ДвоичныеДанные(ИмяВременногоФайла);
		
		// Очищаем за собой временные файлы сервера
		УдалитьФайлы(ИмяВременногоФайла);
		
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("Ошибка генерации PDF УПД: " + ОписаниеОшибки());
		Возврат Ответ;
	КонецПопытки;
	
	// 5. Формируем успешный ответ
	Ответ.КодСостояния = 200;
	Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
	// Подставляем GUID или Номер документа в название скачиваемого файла
	Ответ.Заголовки.Вставить("Content-Disposition", "inline; filename=""UPD_" + СтрокаGUID + ".pdf"""); 
	Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеPDF);
	
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

Функция ВходящиеСделкиПолучитьСписокЗаказов(Запрос)    
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем amo_id из параметров запроса.
	// Если URL выглядит как /api/orders?amo_id=12345
	AmoID = СокрЛП(Запрос.ПараметрыЗапроса.Получить("amo_id"));
	
	// Если вы используете amo_id в пути маршрута (например, /api/orders/{amo_id}),
	// то раскомментируйте следующую строку и закомментируйте предыдущую:
	// AmoID = СокрЛП(Запрос.ПараметрыURL.Получить("amo_id"));

	Если ПустаяСтрока(AmoID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательный параметр amo_id");
	КонецЕсли;
	
	МассивВерсий = Новый Массив;
	
	// 2. Читаем данные из регистра и шапки документа
	Попытка
		ЗапросБД = Новый Запрос;
		ЗапросБД.Текст = 
			"ВЫБРАТЬ
			|	Рег.Версия КАК Версия,
			|	Рег.ЗаказПокупателя КАК ДокументСсылка,
			|	Рег.ЗаказПокупателя.Дата КАК Дата,
			|	Рег.ЗаказПокупателя.СуммаДокумента КАК Сумма,
			|	Рег.ЗаказПокупателя.Проведен КАК Проведен,
			|	Рег.ЗаказПокупателя.Номер КАК Номер
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_ЗаказПокупателя КАК Рег
			|ГДЕ
			|	Рег.amo_id = &AmoID
			|
			|УПОРЯДОЧИТЬ ПО
			|	Рег.Версия УБЫВ"; // Сортируем от последней версии к первой
			
		ЗапросБД.УстановитьПараметр("AmoID", AmoID);
		
		Выборка = ЗапросБД.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтруктураВерсии = Новый Структура;
			СтруктураВерсии.Вставить("version", Выборка.Версия);    
			СтруктураВерсии.Вставить("number", Выборка.Номер);
			СтруктураВерсии.Вставить("id", Строка(Выборка.ДокументСсылка.УникальныйИдентификатор()));
			
			// Форматируем дату в стандартный ISO 8601
			СтруктураВерсии.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			СтруктураВерсии.Вставить("total_sum", Выборка.Сумма);
			СтруктураВерсии.Вставить("is_posted", Выборка.Проведен);
			
			МассивВерсий.Добавить(СтруктураВерсии);
		КонецЦикла;
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при получении списка заказов: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 3. Если по данному amo_id ничего не найдено
	Если МассивВерсий.Количество() = 0 Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Заказы с указанным amo_id не найдены");
	КонецЕсли;
	
	// 4. Формируем успешный ответ
	// Предполагается, что функция УспехJSON корректно сериализует Массив в JSON-строку
	УстановитьЗаголовкиCORS(Ответ);
	Возврат УспехJSON(Ответ, МассивВерсий);
	
КонецФункции

Процедура УстановитьЗаголовкиCORS(Ответ)
	// Для продакшена с авторизацией тут нужно будет заменить "*" на домен AmoCRM
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, Accept, X-Requested-With");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
КонецПроцедуры

Функция CORSМетод1(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	УстановитьЗаголовкиCORS(Ответ);
	Возврат Ответ;
КонецФункции

Функция КонкретныйЗаказПолучитьЗаказ(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	УстановитьЗаголовкиCORS(Ответ); // Если используется CORS
	
	// 1. Получаем GUID из параметров.
	СтрокаGUID = СокрЛП(Запрос.ПараметрыЗапроса.Получить("id"));
	// Если GUID в пути URL, раскомментируйте строку ниже:
	// СтрокаGUID = СокрЛП(Запрос.ПараметрыURL.Получить("id"));

	Если ПустаяСтрока(СтрокаGUID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательный параметр id (GUID)");
	КонецЕсли;
	
	// 2. Преобразуем строку в УникальныйИдентификатор
	Попытка
		УИД = Новый УникальныйИдентификатор(СтрокаGUID);
	Исключение
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат GUID: " + СтрокаGUID);
	КонецПопытки;
	
	// 3. Получаем ссылку на документ по GUID
	СсылкаНаДокумент = Документы.TeMa_ЗаказПокупателя.ПолучитьСсылку(УИД);
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент.Дата) Тогда 
		Возврат ОшибкаJSON(Ответ, 404, "Заказ с указанным GUID не найден в базе данных");
	КонецЕсли;
	
	// 4. Извлекаем данные документа через корректный запрос
	СтруктураЗаказа = Новый Структура;
	
	Попытка
		ЗапросБД = Новый Запрос;
		// ВЫБРАТЬ: выбираем сами ССЫЛКИ, а не их методы
		ЗапросБД.Текст = 
			"ВЫБРАТЬ
			|	Заказ.Ссылка КАК Ссылка,
			|	Заказ.Дата КАК Дата,
			|	Заказ.IDСделкиAmo КАК IDСделкиAmo,
			|	Заказ.АдресДоставки КАК АдресДоставки,
			|	Заказ.СуммаДокумента КАК СуммаДокумента,
			|	Заказ.Проведен КАК Проведен,
			|	Заказ.Контрагент КАК Контрагент,
			|	Заказ.Склад КАК Склад,
			|	Заказ.БанковскийСчетОрганизации КАК БанковскийСчетОрганизации
			|ИЗ
			|	Документ.TeMa_ЗаказПокупателя КАК Заказ
			|ГДЕ
			|	Заказ.Ссылка = &Ссылка;
			|
			|// Получаем табличную часть Товары
			|ВЫБРАТЬ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.Количество КАК Количество,
			|	Товары.Цена КАК Цена,
			|	Товары.Сумма КАК Сумма,
			|	Товары.СуммаНДС КАК СуммаНДС,
			|	Товары.Всего КАК Всего,
			|	ВЫРАЗИТЬ(Товары.НДС КАК ПЕРЕЧИСЛЕНИЕ.СтавкиНДС) КАК СтавкаНДС
			|ИЗ
			|	Документ.TeMa_ЗаказПокупателя.Товары КАК Товары
			|ГДЕ
			|	Товары.Ссылка = &Ссылка";
			
		ЗапросБД.УстановитьПараметр("Ссылка", СсылкаНаДокумент);
		
		ПакетРезультатов = ЗапросБД.ВыполнитьПакет();
		
		// Обработка шапки
		ВыборкаШапки = ПакетРезультатов[0].Выбрать();
		Если ВыборкаШапки.Следующий() Тогда
			СтруктураЗаказа.Вставить("id", СтрокаGUID);
			СтруктураЗаказа.Вставить("amo_id", ВыборкаШапки.IDСделкиAmo);
			СтруктураЗаказа.Вставить("date", Формат(ВыборкаШапки.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			СтруктураЗаказа.Вставить("delivery_address", ВыборкаШапки.АдресДоставки);
			СтруктураЗаказа.Вставить("total_sum", ВыборкаШапки.СуммаДокумента);
			СтруктураЗаказа.Вставить("is_posted", ВыборкаШапки.Проведен);
			
			// Извлекаем GUID из ссылок здесь, на стороне кода 1С
			СтруктураЗаказа.Вставить("contractor_id", ?(ЗначениеЗаполнено(ВыборкаШапки.Контрагент), Строка(ВыборкаШапки.Контрагент.УникальныйИдентификатор()), ""));
			СтруктураЗаказа.Вставить("warehouse_id", ?(ЗначениеЗаполнено(ВыборкаШапки.Склад), Строка(ВыборкаШапки.Склад.УникальныйИдентификатор()), ""));
			СтруктураЗаказа.Вставить("bank_account_id", ?(ЗначениеЗаполнено(ВыборкаШапки.БанковскийСчетОрганизации), Строка(ВыборкаШапки.БанковскийСчетОрганизации.УникальныйИдентификатор()), ""));
		КонецЕсли;
		
		// Обработка табличной части "Товары"
		МассивТоваров = Новый Массив;
		ВыборкаТоваров = ПакетРезультатов[1].Выбрать();
		
		Пока ВыборкаТоваров.Следующий() Цикл
			ТоварСтрока = Новый Структура;
			
			// Извлекаем GUID номенклатуры
			ТоварСтрока.Вставить("nomenclature_id", ?(ЗначениеЗаполнено(ВыборкаТоваров.Номенклатура), Строка(ВыборкаТоваров.Номенклатура.УникальныйИдентификатор()), ""));
			
			ТоварСтрока.Вставить("quantity", ВыборкаТоваров.Количество);
			ТоварСтрока.Вставить("price", ВыборкаТоваров.Цена);
			ТоварСтрока.Вставить("sum", ВыборкаТоваров.Сумма);
			ТоварСтрока.Вставить("vat_sum", ВыборкаТоваров.СуммаНДС);
			ТоварСтрока.Вставить("total", ВыборкаТоваров.Всего);
			
			ИмяСтавкиНДС = XMLСтрока(ВыборкаТоваров.СтавкаНДС);
			ТоварСтрока.Вставить("vat_rate_id", ИмяСтавкиНДС);
			
			МассивТоваров.Добавить(ТоварСтрока);
		КонецЦикла;
		
		СтруктураЗаказа.Вставить("products", МассивТоваров);
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при чтении данных документа: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат УспехJSON(Ответ, СтруктураЗаказа);
КонецФункции

Функция ЛогиСоздать(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	УстановитьЗаголовкиCORS(Ответ);
	
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();
	
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Пустое тело запроса", СтрокаJSON, "/api/logs");
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		ДанныеЛога = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат JSON", СтрокаJSON, "/api/logs");
	КонецПопытки;
	
	// Извлекаем данные из присланного JSON
	Эндпоинт    = ?(ДанныеЛога.Получить("endpoint") <> Неопределено, ДанныеЛога.Получить("endpoint"), "External");
	Метод       = ?(ДанныеЛога.Получить("method") <> Неопределено, ДанныеЛога.Получить("method"), "POST");
	КодОтвета   = ?(ДанныеЛога.Получить("status_code") <> Неопределено, Число(ДанныеЛога.Получить("status_code")), 0);
	AmoID       = ?(ДанныеЛога.Получить("amo_id") <> Неопределено, ДанныеЛога.Получить("amo_id"), "");
	ТелоЗапроса = ?(ДанныеЛога.Получить("request_body") <> Неопределено, ДанныеЛога.Получить("request_body"), "");
	ТелоОтвета  = ?(ДанныеЛога.Получить("response_body") <> Неопределено, ДанныеЛога.Получить("response_body"), "");
	ТекстОшибки = ?(ДанныеЛога.Получить("error_text") <> Неопределено, ДанныеЛога.Получить("error_text"), "");
	
	// Вызываем нашу универсальную процедуру
	ЗаписатьЛогAPI(Эндпоинт, Метод, КодОтвета, ТелоЗапроса, ТелоОтвета, ТекстОшибки, AmoID);
	
	СтруктураОтвета = Новый Структура("status", "log_created");
	Возврат УспехJSON(Ответ, СтруктураОтвета);
КонецФункции

Функция ЛогиПолучить(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	УстановитьЗаголовкиCORS(Ответ);
	
	// 1. Получаем параметры пагинации
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	
	СтрокаЛимит = ПараметрыЗапроса.Получить("limit");
	Лимит = ?(ЗначениеЗаполнено(СтрокаЛимит), Число(СтрокаЛимит), 50); // По умолчанию 50 записей
	
	СтрокаСмещение = ПараметрыЗапроса.Получить("offset");
	Смещение = ?(ЗначениеЗаполнено(СтрокаСмещение), Число(СтрокаСмещение), 0);
	
	// Параметры фильтрации (опционально)
	ФильтрAmoID = ПараметрыЗапроса.Получить("amo_id");
	ФильтрСтатус = ПараметрыЗапроса.Получить("status_code");
	
	// Вычисляем максимальную выборку для первого этапа
	МаксимальноеКоличество = Лимит + Смещение;
	
	// 2. Строим динамический запрос к регистру логов
	ШаблонЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Логи.ИдентификаторЛога КАК id,
	|	Логи.ДатаВремя КАК date_time,
	|	Логи.Метод КАК method,
	|	Логи.Эндпоинт КАК endpoint,
	|	Логи.КодОтвета КАК status_code,
	|	Логи.AmoID КАК amo_id,
	|	Логи.ТелоЗапроса КАК request_body,
	|	Логи.ТелоОтвета КАК response_body,
	|	Логи.ТекстОшибки КАК error_text
	|ИЗ
	|	РегистрСведений.TeMa_ЛогиAPI КАК Логи
	|ГДЕ
	|	ИСТИНА"; // Заглушка для удобного склеивания фильтров
	
	ТекстЗапроса = СтрШаблон(ШаблонЗапроса, Формат(МаксимальноеКоличество, "ЧГ=0"));
	
	// Добавляем фильтры при наличии
	Если ЗначениеЗаполнено(ФильтрAmoID) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Логи.AmoID = &AmoID";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрСтатус) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Логи.КодОтвета = &КодОтвета";
	КонецЕсли;
	
	// Сортировка по убыванию времени (сначала новые)
	ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Логи.ДатаВремя УБЫВ";
	
	ЗапросБД = Новый Запрос(ТекстЗапроса);
	
	// Установка параметров фильтрации
	Если ЗначениеЗаполнено(ФильтрAmoID) Тогда
		ЗапросБД.УстановитьПараметр("AmoID", СокрЛП(ФильтрAmoID));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрСтатус) Тогда
		ЗапросБД.УстановитьПараметр("КодОтвета", Число(ФильтрСтатус));
	КонецЕсли;
	
	// 3. Выполнение запроса и точечная выгрузка диапазона пагинации
	МассивЛогов = Новый Массив;
	РезультатЗапроса = ЗапросБД.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ТаблицаДанных = РезультатЗапроса.Выгрузить();
		
		ИндексНачала = Смещение;
		ИндексКонца  = Мин(ТаблицаДанных.Количество() - 1, Смещение + Лимит - 1);
		
		// Перебираем только строки, попавшие в нужный offset/limit диапазон
		Для Индекс = ИндексНачала По ИндексКонца Цикл
			
			СтрокаДанных = ТаблицаДанных[Индекс];
			
			СтруктураЛога = Новый Структура;
			СтруктураЛога.Вставить("id",            СтрокаДанных.id);
			СтруктураЛога.Вставить("date_time",     Формат(СтрокаДанных.date_time, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			СтруктураЛога.Вставить("method",        СтрокаДанных.method);
			СтруктураЛога.Вставить("endpoint",      СтрокаДанных.endpoint);
			СтруктураЛога.Вставить("status_code",   СтрокаДанных.status_code);
			СтруктураЛога.Вставить("amo_id",        СтрокаДанных.amo_id);
			СтруктураЛога.Вставить("request_body",  СтрокаДанных.request_body);
			СтруктураЛога.Вставить("response_body", СтрокаДанных.response_body);
			СтруктураЛога.Вставить("error_text",    СтрокаДанных.error_text);
			
			МассивЛогов.Добавить(СтруктураЛога);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 4. Возврат ответа с помощью существующей функции УспехJSON
	Возврат УспехJSON(Ответ, МассивЛогов);
КонецФункции

Функция ДоговорыКонтрагентаМетод1(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	УстановитьЗаголовкиCORS(Ответ);
	
	// 1. Получаем параметры фильтрации из URL-строки
	ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	АмоИД         = СокрЛП(ПараметрыЗапроса.Получить("amo_id"));
	ИДКонтрагента = СокрЛП(ПараметрыЗапроса.Получить("contractor_id"));
	
	СсылкаНаКонтрагента = Справочники.Контрагенты.ПустаяСсылка();
	
	// 2. Определяем контрагента (по GUID или по AmoID)
	Если ЗначениеЗаполнено(ИДКонтрагента) Тогда
		Попытка
			СсылкаНаКонтрагента = Справочники.Контрагенты.ПолучитьСсылку(New УникальныйИдентификатор(ИДКонтрагента));
		Исключение
			Возврат ОшибкаJSON(Ответ, 400, "Некорректный формат contractor_id (GUID)", , "/api/counterparties/contracts");
		КонецПопытки;
	ИначеЕсли ЗначениеЗаполнено(АмоИД) Тогда
		ЗапросКРегистру = Новый Запрос;
		ЗапросКРегистру.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИдентификаторыAmoCRM.Контрагент КАК Контрагент
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM КАК ИдентификаторыAmoCRM
			|ГДЕ
			|	ИдентификаторыAmoCRM.ИдентификаторAmoCRM = &АмоИД";
		ЗапросКРегистру.УстановитьПараметр("АмоИД", АмоИД);
		
		ВыборкаКР = ЗапросКРегистру.Выполнить().Выбрать();
		Если ВыборкаКР.Следующий() Тогда
			СсылкаНаКонтрагента = ВыборкаКР.Контрагент;
		КонецЕсли;
	Иначе
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствуют обязательные параметры: передайте amo_id или contractor_id", , "/api/counterparties/contracts");
	КонецЕсли;
	
	// Проверяем существование найденного контрагента в базе
	Если НЕ ЗначениеЗаполнено(СсылкаНаКонтрагента) Или СсылкаНаКонтрагента.ПолучитьОбъект() = Неопределено Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Контрагент не найден в базе 1С", , "/api/counterparties/contracts");
	КонецЕсли;
	
	// 3. Выбираем все действующие договоры этого контрагента
	ЗапросДоговоры = Новый Запрос;
	ЗапросДоговоры.Текст = 
		"ВЫБРАТЬ
		|	Договоры.Ссылка КАК Ссылка,
		|	Договоры.Наименование КАК Наименование,
		|	Договоры.Номер КАК Номер,
		|	Договоры.Дата КАК Дата,
		|	Договоры.Сумма КАК Сумма,
		|	Договоры.ВидДоговора КАК ВидДоговора
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Договоры.Дата УБЫВ"; // Сначала новые договоры
		
	ЗапросДоговоры.УстановитьПараметр("Контрагент", СсылкаНаКонтрагента);
	
	МассивДоговоров = Новый Массив;
	Выборка = ЗапросДоговоры.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДоговора = Новый Структура;
		СтруктураДоговора.Вставить("id",              Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		СтруктураДоговора.Вставить("name",            Выборка.Наименование);
		СтруктураДоговора.Вставить("number",          СокрЛП(Выборка.Номер));
		СтруктураДоговора.Вставить("date",            Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		СтруктураДоговора.Вставить("contract_amount", Выборка.Сумма);
		СтруктураДоговора.Вставить("contract_type",   Строка(Выборка.ВидДоговора));
		
		МассивДоговоров.Добавить(СтруктураДоговора);
		
	КонецЦикла;
	
	// 4. Возвращаем результат
	Возврат УспехJSON(Ответ, МассивДоговоров);
КонецФункции

Функция ГенерацияСчетаПолучитьСписокСчетов(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем amo_id из параметров запроса.
	// Ожидаемый URL: /api/invoices?amo_id=12345
	AmoID = СокрЛП(Запрос.ПараметрыЗапроса.Получить("amo_id"));

	Если ПустаяСтрока(AmoID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательный параметр amo_id");
	КонецЕсли;
	
	МассивСчетов = Новый Массив;
	
	// 2. Читаем данные из регистра и шапки документа
	Попытка
		ЗапросБД = Новый Запрос;
		ЗапросБД.Текст = 
			"ВЫБРАТЬ
			|	Рег.Счет КАК ДокументСсылка,
			|	Рег.Счет.Номер КАК Номер,
			|	Рег.Счет.Дата КАК Дата,
			|	Рег.Счет.СуммаДокумента КАК Сумма,
			|	Рег.Счет.Проведен КАК Проведен
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_Счет КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID
			|
			|УПОРЯДОЧИТЬ ПО
			|	Рег.Счет.Дата УБЫВ"; // Сортируем от самых свежих к старым
			
		ЗапросБД.УстановитьПараметр("AmoID", AmoID);
		
		Выборка = ЗапросБД.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтруктураСчета = Новый Структура;
			СтруктураСчета.Вставить("id", Строка(Выборка.ДокументСсылка.УникальныйИдентификатор()));
			СтруктураСчета.Вставить("number", Выборка.Номер);
			
			// Форматируем дату в стандартный ISO 8601
			СтруктураСчета.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			СтруктураСчета.Вставить("total_sum", Выборка.Сумма);
			СтруктураСчета.Вставить("is_posted", Выборка.Проведен);
			
			МассивСчетов.Добавить(СтруктураСчета);
		КонецЦикла;
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при получении списка счетов: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 3. Если по данному amo_id ничего не найдено
	Если МассивСчетов.Количество() = 0 Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Счета с указанным amo_id не найдены");
	КонецЕсли;
	
	// 4. Формируем успешный ответ
	// Раскомментируйте функцию установки CORS, если она используется глобально для ваших сервисов:
	УстановитьЗаголовкиCORS(Ответ);
	
	Возврат УспехJSON(Ответ, МассивСчетов);
КонецФункции

Функция ГенерацияУПДПолучитьСписокУПД(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем amo_id из параметров запроса.
	// Ожидаемый URL: /api/upd?amo_id=12345 (или аналогичный)
	AmoID = СокрЛП(Запрос.ПараметрыЗапроса.Получить("amo_id"));

	Если ПустаяСтрока(AmoID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательный параметр amo_id");
	КонецЕсли;
	
	МассивУПД = Новый Массив;
	
	// 2. Читаем данные из регистра и шапки документа
	Попытка
		ЗапросБД = Новый Запрос;
		ЗапросБД.Текст = 
			"ВЫБРАТЬ
			|	Рег.УПД КАК ДокументСсылка,
			|	Рег.УПД.Номер КАК УПДНомер,
			|	Рег.УПД.Дата КАК УПДДата,
			|	Рег.УПД.Проведен КАК УПДПроведен
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_УПД КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID"; 
			
		ЗапросБД.УстановитьПараметр("AmoID", AmoID);
		
		Выборка = ЗапросБД.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтруктураУПД = Новый Структура;
			СтруктураУПД.Вставить("id", Строка(Выборка.ДокументСсылка.УникальныйИдентификатор()));
			
			// 1. Защищаем номер: если пришел NULL, ставим пустую строку, иначе принудительно делаем строкой
			СтроковыйНомер = ?(Выборка.УПДНомер = Null, "", Строка(Выборка.УПДНомер));
			СтруктураУПД.Вставить("number", СтроковыйНомер);
			
			// 2. Защищаем дату от NULL
			СтроковаяДата = ?(Выборка.УПДДата = Null, "", Формат(Выборка.УПДДата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
			СтруктураУПД.Вставить("date", СтроковаяДата);
			
			// 3. Вы забыли добавить статус проведения в структуру. 
			// Приравнивание к Истине гарантирует тип Булево, даже если пришел NULL.
			СтруктураУПД.Вставить("is_posted", Выборка.УПДПроведен = Истина);
			
			МассивУПД.Добавить(СтруктураУПД);
		КонецЦикла;
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при получении списка УПД: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 3. Если по данному amo_id ничего не найдено
	Если МассивУПД.Количество() = 0 Тогда
		Возврат ОшибкаJSON(Ответ, 404, "УПД с указанным amo_id не найдены");
	КонецЕсли;
	
	// 4. Формируем успешный ответ
	// УстановитьЗаголовкиCORS(Ответ); // Раскомментируйте, если требуется CORS
	Возврат УспехJSON(Ответ, МассивУПД);
КонецФункции

Функция ГенерацияДКППолучитьДКП(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	// 1. Получаем amo_id из параметров запроса.
	// Ожидаемый URL: /api/contracts?amo_id=12345
	AmoID = СокрЛП(Запрос.ПараметрыЗапроса.Получить("amo_id"));

	Если ПустаяСтрока(AmoID) Тогда
		Возврат ОшибкаJSON(Ответ, 400, "Отсутствует обязательный параметр amo_id");
	КонецЕсли;
	
	МассивДоговоров = Новый Массив;
	
	// 2. Читаем данные из регистра и карточки договора
	Попытка
		ЗапросБД = Новый Запрос;
		ЗапросБД.Текст = 
			"ВЫБРАТЬ
			|	Рег.Договор КАК Ссылка,
			|	Рег.Договор.Наименование КАК Наименование,
			|	Рег.Договор.Ссылка КАК ДоговорСсылка,
			|	Рег.Договор.Код КАК ДоговорКод,
			|	Рег.Договор.Дата КАК ДоговорДата
			|ИЗ
			|	РегистрСведений.TeMa_ИдентификаторыAmoCRM_Договор КАК Рег
			|ГДЕ
			|	Рег.ИдентификаторAmoCRM = &AmoID"; 
			
		ЗапросБД.УстановитьПараметр("AmoID", AmoID);
		
		Выборка = ЗапросБД.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
		    СтруктураДоговора = Новый Структура;             
		    СтруктураДоговора.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		    СтруктураДоговора.Вставить("name", ?(Выборка.Наименование = Null, "", Выборка.Наименование));
		    СтруктураДоговора.Вставить("number", ?(Выборка.ДоговорКод = Null, "", Строка(Выборка.ДоговорКод)));
		    
		    // Безопасное форматирование даты
		    Если ЗначениеЗаполнено(Выборка.ДоговорДата) Тогда
		        СтруктураДоговора.Вставить("date", Формат(Выборка.ДоговорДата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		    Иначе
		        СтруктураДоговора.Вставить("date", ""); // или Null
		    КонецЕсли;
		    
		    МассивДоговоров.Добавить(СтруктураДоговора);
		КонецЦикла;
		
	Исключение
		Возврат ОшибкаJSON(Ответ, 500, "Ошибка при получении списка договоров: " + ОписаниеОшибки());
	КонецПопытки;
	
	// 3. Если по данному amo_id ничего не найдено
	Если МассивДоговоров.Количество() = 0 Тогда
		Возврат ОшибкаJSON(Ответ, 404, "Договоры с указанным amo_id не найдены");
	КонецЕсли;
	
	// 4. Формируем успешный ответ
	// Раскомментируйте функцию установки CORS, если она используется глобально для ваших сервисов:
	УстановитьЗаголовкиCORS(Ответ);
	
	Возврат УспехJSON(Ответ, МассивДоговоров);
КонецФункции
